battery PosSupply {  # The switch feeds a unity-gain inverting stage; named positive/negative rails are separate supplies.
    V = 2;
    wire = pos;
}

battery NegSupply {
    Vneg = 5;
    wire = neg;
}
main{  # Assemble the declared parts and chips using the named connections below.
    S1(closed) between(pos, W2);

    R2(10k) between(W2, W3);
    parallel(W3, out){
    wire = w4;
    R1 = 10k;
    }

    op1(0, w4, out, pos, neg);  # Ideal amplifier: the feedback connections determine this channel's behavior.
}


