battery PosSupply {
    V = 2;
    wire = pos;
}

battery NegSupply {
    Vneg = 5;
    wire = neg;
}
main{
    S1(open) between(pos, W2);

    R2(10k) between(W2, W3);
    parallel(W3, out){
    wire = w4;
    R1 = 10k;
    }

    op1(0, w4, out, pos, neg);
}


