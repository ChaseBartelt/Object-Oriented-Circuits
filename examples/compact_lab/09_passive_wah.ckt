# Passive wah-style resonator: probe tone while changing f.
# CTank tunes the LC resonance; 100n with 100m resonates near 1.592 kHz.
V1(1 Vrms) between(vin, 0);
f = 1.59155k

series feed(input, output) {
    CBlock = 1u;
    RDrive = 1k;
}
parallel tank(input, ground) {
    LTank = 100m;
    CTank = 100n;
    RLoad = 10k;
}
main {
    feed(vin, tone);
    tank(tone, 0);
}
# @pin {"node":"tone","name":"Resonant output"}
