# Pulse-reset envelope: a short gate discharges the capacitor, then it recharges.
# Results: probe envelope and gate; step 20u, run for 24m. No initial voltage needed.
# RCharge * CEnvelope sets the rise time (4.7 ms); the pulse repeats every 8 ms.
# Change the last pulse argument for the rhythm, or RCharge for a steeper ramp.
# Generic NPN model: this is an electrical demonstration, not a calibrated device.

VCC(5) between(vcc, 0);
VGate(pulse(0, 5, 1m, 10u, 10u, 1m, 8m)) between(gate, 0);

RB(22k) between(gate, base);
RCharge(47k) between(vcc, envelope);
CEnvelope(100n) between(envelope, 0);
transQReset(base, envelope, 0, npn);


