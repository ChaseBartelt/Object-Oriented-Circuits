# Three-input majority vote: high when at least two inputs are high.
# Change VA/VB/VC to 0 or 5; probe vote. Default (1,0,1) votes high.
# Built-in gates expand to analog transistor circuits; omitted ground is 0.
VCC(5) between(vcc, 0);
VA(5) between(a, 0);
VB(0) between(b, 0);
VC(5) between(c, 0);

nand(vcc, a, b, ab_n);
nand(vcc, b, c, bc_n);
nand(vcc, c, a, ca_n);
nand(vcc, (ab_n, bc_n, ca_n), vote);

# @pin {"node":"vote","name":"Majority vote"}
# Nominal 5 V logic demo; voltages are approximate, not a rated logic IC.


