# Metallic percussion: two damped modes struck by a narrow pulse. Probe out.
# Results: time step 2 us, Run; no initial capacitor voltage required.
include("patches/metal_modes.ckt");
connector(hit, bell0, bell1);
VHit(pulse(0, 5, 100u, 2u, 2u, 20u, 2m)) between(hit, 0);

main {
    for (int i = 0; i < 2; i++) {
        op${i + 1}(bell${i}, voice${i}, voice${i});
        RMix${i}(20k) between(voice${i}, sum);
    }
    RF(10k) between(sum, out);
    op3(0, sum, out);
    measure = V out 0;
}


