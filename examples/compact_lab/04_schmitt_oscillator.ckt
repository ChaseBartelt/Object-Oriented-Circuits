# A Schmitt RC oscillator with a startup/reset clamp for a stable DC solve.
# Results: probe out and timing; step 20u, run for 8m. No initial voltage needed.
# Increase RFeedback or CTiming to slow it down; halve either to speed it up.
# This approximate CD40106B model oscillates near 2.4 kHz with these settings.
# All six inverter channels are simulated, so this example is slower than 03.
# The clamp releases after 110 us and rearms every 10 ms; observe the first 8 ms.
# For SPICE waveform comparisons, set the maximum transient timestep to 20u.

include("CD40106B");
VCC(5) between(vcc, 0);
RFeedback(100k) between(out, timing);
CTiming(10n) between(timing, 0);
VStart(pulse(5, 0, 100u, 10u, 10u, 9m, 10m)) between(startup, 0);
switchStart(startup, 0, timing, 0, 2.5, 10, 1G);

main {
    # Physical pins 1..14: channel 1 is active; unused inputs go to ground.
    # The five unused outputs stay separate, not shorted together or to ground.
    CD40106B(timing, out, 0, idle2, 0, idle3, 0, idle4, 0, idle5, 0, idle6, 0, vcc);
}
