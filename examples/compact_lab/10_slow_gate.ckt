# Override the built-in inverter with a deliberately slow rising output.
# Results: probe clock and out; step 10u, run for 12m. No initial voltage needed.
# RC * CNode = 220 us: increase either to soften the rising edge further.
# The generic NPN actively pulls low; the resistor charges the output high.
@Override
gate not(vcc, gnd, a, y) {
    RC(22k) between(vcc, y);
    RB(47k) between(a, base);
    CNode(10n) between(y, gnd);
    transQ1(base, y, gnd, npn);
}

VCC = 5 : wire = vcc;
VClock(pulse(0, 5, 1m, 10u, 10u, 1m, 4m)) between(clock, 0);
main { not(vcc, clock, out); }


