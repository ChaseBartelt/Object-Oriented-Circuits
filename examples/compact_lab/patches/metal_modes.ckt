# Shared patch terminals; local component names stay scoped to this file.
connector(hit, bell0, bell1);
circuit mode(l, c, r, input, output) {
    l between(input, tap);
    c between(tap, output);
    r between(output, 0);
}
main {
    mode(L1(22m), C1(100n), R1(150), hit, bell0);
    mode(L2(10m), C2(47n), R2(100), hit, bell1);
}
