
# Three-way active crossover
V1(1 Vrms) between(source, 0);
f = 1k

circuit Filter(part1, part2, input, output, ground) {
    part1 between(input, tap);
    part2 between(tap, ground);
    op1(tap, output, output);
}

circuit InputBuffer(input, output, ground) {
    R1(100) between(input, sense);
    R2(100k) between(sense, ground);
    op1(sense, output, output);
}

circuit SpeakerLoad(input, ground) {
    R1(1) between(input, speaker);
    R2(8) between(speaker, ground);
}

main {
    InputBuffer(source, vin, 0);

    # Low band: two low-pass stages
    Filter(R1(4.02k), C1(100n), vin, lo1, 0);
    Filter(R2(4.02k), C2(100n), lo1, low, 0);
    SpeakerLoad(low, 0);

    # Mid band: high-pass then low-pass
    Filter(C3(100n), R3(4.02k), vin, mid1, 0);
    Filter(R4(3.9k), C4(10n), mid1, mid, 0);
    SpeakerLoad(mid, 0);

    # High band: two high-pass stages
    Filter(C5(10n), R5(3.9k), vin, hi1, 0);
    Filter(C6(10n), R6(3.9k), hi1, high, 0);
    SpeakerLoad(high, 0);
}


