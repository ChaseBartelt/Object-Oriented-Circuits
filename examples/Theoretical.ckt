
# Inverting amplifier with source impedance,
# feedback impedance, and output load.

f = 60

Vac(1 Vpk) between(input, 0);

# Source impedance (Zs)
R2(1k) between(input, n1);
C1(10n) between(n1, inv);

# Op-amp: negative, positive, output
op1(0, inv, output);

# Feedback impedance (Zf)
R1(10k) between(output, inv);

# Output load
RLoad(100k) between(output, 0);


