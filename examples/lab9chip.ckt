include("@chips/converters/LT1677.ckt");

Vpos(2V) between(vcc, 0);
Vneg(-5V) between(vee, 0);

main{
    //First Series Chain
    series(vcc,w1){
        SbuttonA(closed);
        R2(10k);
    }
    // Second series chain
    series(vcc, w1){
        SbuttonB(closed);
        R6(10k);
        R7(10k);
    }
    //Third chain
    series(vcc,w1){
        SbuttonC(closed);
        parallel{
            R3(10k);
            R5(10k);
        }
    }

    // Op-amp feedback resistor
    R1(10k) between(output, w1);

    # LT1677 physical pin order
    LT1677(trim1, w1, 0, vee,
           nc5, output, vcc, trim8);
    
           measure = V output 0;
}
