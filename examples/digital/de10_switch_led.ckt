# DE10-Lite: each switch controls its matching LED (up = on, down = off).
# The FPGA build adds a separate two-stage synchronizer for every switch.
chip HYBRID01(MAX10_CLK1_50, SW0, SW1, SW2, SW3, SW4, SW5, SW6, SW7, SW8, SW9, LEDR0, LEDR1, LEDR2, LEDR3, LEDR4, LEDR5, LEDR6, LEDR7, LEDR8, LEDR9) {
    MAX10_CLK1_50 = input;
    SW0, SW1, SW2, SW3, SW4, SW5, SW6, SW7, SW8, SW9 = input;
    LEDR0, LEDR1, LEDR2, LEDR3, LEDR4, LEDR5, LEDR6, LEDR7, LEDR8, LEDR9 = output;

    LEDR0 = SW0;
    LEDR1 = SW1;
    LEDR2 = SW2;
    LEDR3 = SW3;
    LEDR4 = SW4;
    LEDR5 = SW5;
    LEDR6 = SW6;
    LEDR7 = SW7;
    LEDR8 = SW8;
    LEDR9 = SW9;
}
