# 50 MHz clock: SW0 selects approximately 440/880 Hz; LED toggles every 0.5 s.
# DE10-Lite pin assignments, timing constraints and build: fpga/de10_lite/README.md.
chip HYBRID01(MAX10_CLK1_50, SW0, LEDR0, AUDIO_OUT) {
    MAX10_CLK1_50, SW0 = input;
    LEDR0, AUDIO_OUT = output;

    phase[32];
    led_state;
    sw_meta;
    sw_sync;

    clock(MAX10_CLK1_50, 50MHz) {
        sw_meta = SW0;
        sw_sync = sw_meta;
        if (sw_sync == 0) {
            phase += 440Hz;
        } else {
            phase += 880Hz;
        }
        every(500ms) {
            led_state = !led_state;
        }
    }
    AUDIO_OUT = phase[31];
    LEDR0 = led_state;
}
