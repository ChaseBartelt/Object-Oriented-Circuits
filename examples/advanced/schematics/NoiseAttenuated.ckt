Vin(1 Vrms) between(input, 0);  # Use the declared component connections and measurements to inspect the signal attenuation network.
f = 60;

main {  # Assemble the declared parts and chips using the named connections below.
    series(input, A) {
        R2 = 1k;
        C1 = 10n;
    }

    op1(0, A, output);  # Ideal amplifier: the feedback connections determine this channel's behavior.
    R1(10k) between(A, output);

    measure = V output 0;
}