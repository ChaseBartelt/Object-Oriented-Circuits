# ASYMMETRIC FOUR-BJT ASTABLE WITH BUFFERED OUTPUTS -- Auto/DC, then Results oscilloscope
# Scope: node c1 or out1; time step 5 us; initial capacitor C1 at +1 V; run for at least 10 ms.
# Cross-coupled 10n/15n timing capacitors and 56k/47k base feeds give unequal high/low intervals.
# First estimate T=ln(2)*(56k*10n+47k*15n)=0.877 ms; generic BJT thresholds/loading shift it.
# Native simulation at 5 us settles near 1.072 kHz: c1 high 0.490 ms, low 0.443 ms at 2.5 V threshold.
# c1/c2 alternate between near ground and near 5 V; out1/out2 follow about one Vbe lower.
# monitor is an additional 100k/2.2n low-pass view of c1. DC results show bias, not oscillation.
# Uses native generic NPNs; timing is illustrative, without a specific transistor's parasitics.
VCC(5) between(vcc, 0);

main {
    RC1(4.7k) between(vcc, c1);
    RC2(5.6k) between(vcc, c2);
    RB1(47k) between(vcc, b1);
    RB2(56k) between(vcc, b2);
    C1(10n) between(c1, b2);
    C2(15n) between(c2, b1);
    transQ1(b1, c1, 0, npn);
    transQ2(b2, c2, 0, npn);

    Rbuffer1(1k) between(c1, bufferBase1);
    Rbuffer2(1k) between(c2, bufferBase2);
    transQ3(bufferBase1, vcc, out1, npn);
    transQ4(bufferBase2, vcc, out2, npn);
    Remitter1(22k) between(out1, 0);
    Remitter2(22k) between(out2, 0);
    Rmonitor(100k) between(c1, monitor);
    Cmonitor(2.2n) between(monitor, 0);

    measure = V c1 0;
    measure = V c2 0;
    measure = V out1 0;
    measure = V out2 0;
    measure = V monitor 0;
}


