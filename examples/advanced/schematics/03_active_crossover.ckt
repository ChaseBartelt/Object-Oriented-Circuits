# COMPLEMENTARY THREE-BAND ACTIVE CROSSOVER -- Auto/AC
# Buffered double RC poles at 400 Hz and 4 kHz: L=(1+j*f/400)^-2, U=(1+j*f/4000)^-2.
# low=L, mid=U-L, high=1-U; their electrical sum is exactly the original input.
# At 1 kHz/1 Vrms, expect low=-0.099881-j0.095125 V, mid=0.930331-j0.347782 V,
# high=0.169550+j0.442907 V, reconstructed=1 V, and reconstruction error near zero.
# Change f to sweep. This demonstrates complementary voltage paths, not an acoustic speaker design.
# Ideal buffers isolate each RC section and load; no rail, power or bandwidth limits are modeled.
Vin(1 Vrms) between(input, 0);
f = 1k;

circuit low400(input, output, ground) {
    R1(10k) between(input, pole1);
    C1(39.78873577297384n) between(pole1, ground);
    op1(pole1, buffered, buffered);
    R2(10k) between(buffered, pole2);
    C2(39.78873577297384n) between(pole2, ground);
    op2(pole2, output, output);
}

circuit low4k(input, output, ground) {
    R1(10k) between(input, pole1);
    C1(3.978873577297384n) between(pole1, ground);
    op1(pole1, buffered, buffered);
    R2(10k) between(buffered, pole2);
    C2(3.978873577297384n) between(pole2, ground);
    op2(pole2, output, output);
}

circuit difference(positive, negative, output, ground) {
    R1(10k) between(positive, plus);
    R2(10k) between(plus, ground);
    R3(10k) between(negative, minus);
    R4(10k) between(output, minus);
    op1(plus, minus, output);
}

main {
    op1(input, buffered, buffered);
    low400(buffered, low, 0);
    low4k(buffered, upperLow, 0);
    difference(upperLow, low, mid, 0);
    difference(buffered, upperLow, high, 0);

    Rlow(10k) between(low, sum);
    Rmid(10k) between(mid, sum);
    Rhigh(10k) between(high, sum);
    RsumFeedback(10k) between(invertedSum, sum);
    op2(0, sum, invertedSum);
    Rinvert(10k) between(invertedSum, inverse);
    Rrestore(10k) between(reconstructed, inverse);
    op3(0, inverse, reconstructed);

    RloadLow(10k) between(low, 0);
    RloadMid(10k) between(mid, 0);
    RloadHigh(10k) between(high, 0);
    RloadSum(10k) between(reconstructed, 0);
    measure = V low 0;
    measure = V mid 0;
    measure = V high 0;
    measure = V reconstructed 0;
    measure = V reconstructed input;
}


