// OCTANT | eight-channel signal scanner and over-threshold detector
// Solve in Auto for the resting levels. In the oscilloscope, watch monitor or
// average with a 100 us time step. Close Sscan to scan all eight inputs.

include("analog_blocks.ckt");

// Faster local averaging keeps individual three-millisecond scan slots visible.
@override
chip OctantReadout {
    analog {
        properties { average.time = 2ms; }
    }
}

connector(trip0, trip1, trip2, trip3, trip4, trip5, trip6, trip7, monitor, average);
Vlogic(5V) between(vcc, 0);

main {
    OctantStimulus(0, raw3, raw2, raw1, raw0, raw4, raw5, raw6, raw7);
    for (int channel = 0; channel < 8; channel++) {
        measure = V trip${channel} 0;
    }

    // Each open-collector trip goes high when its filtered level exceeds the reference.
    threshold = count;
    RreferenceUpper(22k) between(vcc, threshold*);
    RreferenceLower(10k) between(threshold^, 0);
    SreferenceDemo(open) between(threshold^, threshold*);
    RreferenceDemo(22k) between(threshold^, 0);
    OctantBank(raw0, raw1, raw2, raw3, threshold1, vcc, 0, level3,
               trip3, level2, trip2, level1, trip1, level0, trip0);
    OctantBank(raw4, raw5, raw6, raw7, threshold1, vcc, 0, level7,
               trip7, level6, trip6, level5, trip5, level4, trip4);

    // The selector address is binary. Sselect0 is the least significant bit.
    for (int bit = 0; bit < 3; bit++) {
        Sselect${bit}(open) between(vcc, manual${bit});
    }
    Sscan(open) between(vcc, scan);
    Sinhibit(open) between(vcc, inhibit);
    OctantAddress(manual0, manual1, manual2, scan, 0, select2, select1, select0);

    OctantMux(level0, level1, level2, level3, level4, level5, level6, level7,
              0, bus, inhibit, select2, select1, select0, vcc);
    OctantReadout(bus, 0, monitor, average);

    Cbulk(10uF) between(vcc, 0);
    Cbypass(100nF) between(vcc, 0);
    measure = V threshold1 0;
    measure = V monitor 0;
    measure = V average 0;
}


