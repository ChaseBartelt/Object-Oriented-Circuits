// Daisy Seed Rev 4 audio path. SAI1 A is a master transmitter and B is its
// synchronous receiver. Two DMA1 streams move samples through the firmware's
// actual circular buffers, one granted SRAM word at a time.

chip STM32H750DaisySAIBlock(clk, reset, write_enable, register_index, write_data, status,
                            data_register, read_data, control, stereo_slots, flush_fifo) {
    input {
        clk, reset, write_enable;
        register_index[3], write_data[32], status[32], data_register[32];
    }
    output {
        read_data[32], control[32], stereo_slots, flush_fifo;
    }

    const CR1[3] = 0;
    const CR2[3] = 1;
    const FRCR[3] = 2;
    const SLOTR[3] = 3;
    const IMR[3] = 4;
    const SR[3] = 5;
    const DR[3] = 7;
    const CR2_KEEP[32] = 4294967287;
    cr1[32] = 0;
    cr2[32] = 0;
    frcr[32] = 7;
    slotr[32] = 0;
    imr[32] = 0;
    control = cr1;
    // HAL enables all sixteen mask bits, even when the frame has only two slots.
    stereo_slots = frcr[7:0] == 63 && slotr[11:8] == 1 && slotr[17:16] == 3;
    flush_fifo = write_enable && register_index == CR2 && write_data[3];

    switch (register_index) {
        case CR1: read_data = cr1; break;
        case CR2: read_data = cr2; break;
        case FRCR: read_data = frcr; break;
        case SLOTR: read_data = slotr; break;
        case IMR: read_data = imr; break;
        case SR: read_data = status; break;
        case DR: read_data = data_register; break;
        default: read_data = 0; break; // CLRFR has no latched error flags in this path.
    }

    clock(clk, 10kHz) {
        if (reset) {
            clear { cr1, cr2 };
            frcr = 7;
            clear { slotr, imr };
        } else if (write_enable) {
            switch (register_index) {
                case CR1: cr1 = write_data; break;
                case CR2: cr2 = write_data & CR2_KEEP; break;
                case FRCR: frcr = write_data; break;
                case SLOTR: slotr = write_data; break;
                case IMR: imr = write_data; break;
                default: break;
            }
        }
    }
}

chip STM32H750DaisyDMAStream(clk, reset, write_enable, register_index, write_data,
                            transfer, clear_half, clear_complete, read_data,
                            memory_address, peripheral_address, control, active, half, complete, irq) {
    input {
        clk, reset, write_enable, transfer, clear_half, clear_complete;
        register_index[3], write_data[32];
    }
    output {
        read_data[32], memory_address[32], peripheral_address[32], control[32];
        active, half, complete, irq;
    }

    const CR[3] = 0;
    const NDTR[3] = 1;
    const PAR[3] = 2;
    const M0AR[3] = 3;
    const M1AR[3] = 4;
    const FCR[3] = 5;
    const ZERO32[32] = 0;
    const DISABLE[32] = 4294967294;
    cr[32] = 0;
    count[16] = 0;
    remaining[16] = 0;
    peripheral[32] = 0;
    memory0[32] = 0;
    memory1[32] = 0;
    fcr[8] = 1;
    half_pending = 0;
    complete_pending = 0;

    item_index[16] = count - remaining;
    byte_offset[32] = (ZERO32 + item_index) << 2;
    memory_address = memory0 + (cr[10] ? byte_offset : 0);
    peripheral_address = peripheral;
    control = cr;
    active = cr[0] && remaining != 0;
    half = half_pending;
    complete = complete_pending;
    irq = (half_pending && cr[3]) || (complete_pending && cr[4]);

    switch (register_index) {
        case CR: read_data = cr; break;
        case NDTR: read_data = remaining; break;
        case PAR: read_data = peripheral; break;
        case M0AR: read_data = memory0; break;
        case M1AR: read_data = memory1; break;
        case FCR: read_data = 32 | fcr; break; // Direct mode FIFO status is empty.
        default: read_data = 0; break;
    }

    clock(clk, 10kHz) {
        if (reset) {
            clear { cr, count, remaining, peripheral, memory0, memory1 };
            fcr = 1;
            clear { half_pending, complete_pending };
        } else {
            if (clear_half) { half_pending = 0; }
            if (clear_complete) { complete_pending = 0; }
            if (write_enable && register_index == CR) {
                cr = write_data;
            } else if (write_enable && !cr[0]) {
                switch (register_index) {
                    case NDTR: count = write_data[15:0]; remaining = write_data[15:0]; break;
                    case PAR: peripheral = write_data; break;
                    case M0AR: memory0 = write_data; break;
                    case M1AR: memory1 = write_data; break;
                    case FCR: fcr = write_data[7:0] & 135; break;
                    default: break;
                }
            }
            if (transfer && active) {
                if (count > 1 && remaining - 1 == count - (count >> 1)) { half_pending = 1; }
                if (remaining == 1) {
                    complete_pending = 1;
                    remaining = cr[8] ? count : 0;
                    if (!cr[8]) { cr = cr & DISABLE; }
                } else { remaining = remaining - 1; }
            }
        }
    }
}

chip STM32H750DaisyCodec(frame, right_slot, sample) {
    input {
        frame[32], right_slot;
    }
    output {
        sample[32];
    }

    // A repeatable signed 24-bit stimulus replaces the unconnected analog source.
    // The channels are a quarter period apart, so a swap is visible in the viewer.
    phase[3] = frame[2:0] + (right_slot ? 2 : 0);
    // The low two phase bits choose a triangular magnitude; bit two
    // selects its signed 24-bit half-period, then the bus zero-extends it.
    const ZERO24[24] = 0;
    magnitude[24] = phase[1:0] == 2 ? 4194304 : phase[0] ? 2097152 : 0;
    sample = phase[2] ? ZERO24 - magnitude : magnitude;
}

chip STM32H750DaisyAudio(clk, reset, address, size_code, write_data, write_enable,
                       sai_enabled, dma_enabled, codec_reset_n, dma_grant, dma_read_data,
                       read_data, mapped, dma_request, dma_write, dma_address, dma_write_data,
                       irq0, irq1, output_left, output_right, frame_count, input_left, input_right) {
    input {
        clk, reset, write_enable, sai_enabled, dma_enabled, codec_reset_n, dma_grant;
        address[32], size_code[2], write_data[32], dma_read_data[32];
    }
    output {
        read_data[32], dma_address[32], dma_write_data[32];
        output_left[32], output_right[32], frame_count[32], input_left[32], input_right[32];
        mapped, dma_request, dma_write, irq0, irq1;
    }

    const SAI_GCR[32] = 1073829888;  // SAI1 0x40015800
    const SAI_DR_A[32] = 1073829920;
    const SAI_DR_B[32] = 1073829952;
    const SAI_PDMCR[32] = 1073829956;
    const SAI_PDMDLY[32] = 1073829960;
    const DMA_LISR[32] = 1073872896; // DMA1 0x40020000
    const DMA_HISR[32] = 1073872900;
    const DMA_LIFCR[32] = 1073872904;
    const DMA_HIFCR[32] = 1073872908;
    const MUX_C0CR[32] = 1073874944; // DMAMUX1 0x40020800
    const MUX_C1CR[32] = 1073874948;
    const MUX_CSR[32] = 1073875072;
    const MUX_CFR[32] = 1073875076;
    const PCM_MASK[32] = 16777215;
    // Clock cycles per slot in the interactive model. This preserves sample and
    // interrupt order while keeping the timing independent of the 48 kHz PLL.
    const SLOT_LAST_CYCLE[6] = 31;

    gcr[32] = 0;
    pdmcr[32] = 0;
    pdmdly[32] = 0;
    mux0[32] = 0;
    mux1[32] = 0;
    tx_pending = 0;
    rx_pending = 0;
    tx_word[32] = 0;
    rx_word[32] = 0;
    slot_cycle[6] = 0;
    right_slot = 0;
    out_l[32] = 0;
    out_r[32] = 0;
    in_l[32] = 0;
    in_r[32] = 0;
    frames[32] = 0;

    wire {
        word_access, sai_common, dma_common, mux_mapped, clear_irq;
    }
    word_access = size_code == 2 && address[1:0] == 0;
    sai_common = word_access && (address == SAI_GCR || address == SAI_PDMCR || address == SAI_PDMDLY);
    dma_common = word_access && address >= DMA_LISR && address <= DMA_HIFCR;
    mux_mapped = word_access && (address == MUX_C0CR || address == MUX_C1CR ||
                                 address == MUX_CSR || address == MUX_CFR);
    mapped = sai0 || sai1 || sai_common || stream0 || stream1 || dma_common || mux_mapped;
    clear_irq = dma_enabled && word_access && address == DMA_LIFCR && write_enable;
    sai0_status[32] = tx_pending ? 65536 : 8;
    sai1_status[32] = rx_pending ? 65544 : 0;
    sai0_word[32] = tx_word;
    sai1_word[32] = rx_word;
    wire {
        tx_transfer, rx_transfer;
        stream0_transfer, stream1_transfer;
    }
    stream0_transfer = tx_transfer;
    stream1_transfer = rx_transfer;

    // Each stereo direction owns the same SAI registers and DMA stream logic.
    for (int channel = 0; channel < 2; channel++) {
        const SAI_FIRST_*{channel}[32] = *{1073829892 + 32 * channel};
        const DMA_FIRST_*{channel}[32] = *{1073872912 + 24 * channel};
        wire {
            sai*{channel}, stream*{channel}, sai*{channel}_write, stream*{channel}_write;
        }
        sai*{channel} = word_access && address >= SAI_FIRST_*{channel} && address <= SAI_FIRST_*{channel} + 28;
        stream*{channel} = word_access && address >= DMA_FIRST_*{channel} && address <= DMA_FIRST_*{channel} + 20;
        sai*{channel}_index[3] = (address - SAI_FIRST_*{channel}) >> 2;
        stream*{channel}_index[3] = (address - DMA_FIRST_*{channel}) >> 2;
        sai*{channel}_write = sai_enabled && sai*{channel} && write_enable;
        stream*{channel}_write = dma_enabled && stream*{channel} && write_enable;
        wire {
            sai*{channel}_data[32], sai*{channel}_control[32], stream*{channel}_data[32];
            stream*{channel}_mem[32], stream*{channel}_periph[32], stream*{channel}_control[32];
            sai*{channel}_slots, sai*{channel}_flush, stream*{channel}_active, stream*{channel}_irq;
            half*{channel}, complete*{channel}, clear_half*{channel}, clear_complete*{channel};
        }
        clear_half*{channel} = clear_irq && write_data[6 * channel + 4];
        clear_complete*{channel} = clear_irq && write_data[6 * channel + 5];
        STM32H750DaisySAIBlock(clk, reset, sai*{channel}_write, sai*{channel}_index, write_data,
                              sai*{channel}_status, sai*{channel}_word, sai*{channel}_data,
                              sai*{channel}_control, sai*{channel}_slots, sai*{channel}_flush);
        STM32H750DaisyDMAStream(clk, reset, stream*{channel}_write, stream*{channel}_index, write_data,
                               stream*{channel}_transfer, clear_half*{channel}, clear_complete*{channel},
                               stream*{channel}_data, stream*{channel}_mem, stream*{channel}_periph,
                               stream*{channel}_control, stream*{channel}_active, half*{channel},
                               complete*{channel}, stream*{channel}_irq);
        irq*{channel} = dma_enabled && stream*{channel}_irq;
    }
    low_interrupt_status[32] = ((half0 ? 16 : 0) | (complete0 ? 32 : 0) |
                                (half1 ? 1024 : 0) | (complete1 ? 2048 : 0));

    sai_read[32] = !sai_enabled ? 0 : (sai0 ? sai0_data : (sai1 ? sai1_data :
                    (address == SAI_GCR ? gcr : (address == SAI_PDMCR ? pdmcr : pdmdly))));
    dma_read[32] = !dma_enabled ? 0 : (stream0 ? stream0_data : (stream1 ? stream1_data :
                    (address == DMA_LISR ? low_interrupt_status :
                    (address == MUX_C0CR ? mux0 : (address == MUX_C1CR ? mux1 : 0)))));
    read_data = !mapped ? 0 : ((sai0 || sai1 || sai_common) ? sai_read : dma_read);

    wire {
        tx_ready, rx_ready, serial_active, rx_request, tx_request, emit_slot, write_tx_register;
    }
    tx_ready = (dma_enabled && sai_enabled && sai0_control[17] && stream0_active && mux0[6:0] == 87 &&
                stream0_control[7:6] == 1 && stream0_control[14:11] == 10 && !stream0_control[18] &&
                stream0_periph == SAI_DR_A);
    rx_ready = (dma_enabled && sai_enabled && sai1_control[17] && stream1_active && mux1[6:0] == 88 &&
                stream1_control[7:6] == 0 && stream1_control[14:11] == 10 && !stream1_control[18] &&
                stream1_periph == SAI_DR_B);
    serial_active = (tx_ready && rx_ready && codec_reset_n && sai0_control[16] && sai1_control[16] &&
                     sai0_control[1:0] == 0 && sai1_control[1:0] == 3 && sai1_control[11:10] == 1 &&
                     sai0_control[7:5] == 6 && sai1_control[7:5] == 6 && sai0_slots && sai1_slots);
    rx_request = rx_ready && rx_pending;
    // HAL waits for its first transmit FIFO word before setting A's SAIEN.
    tx_request = tx_ready && !tx_pending && !rx_request;
    dma_request = rx_request || tx_request;
    dma_address = rx_request ? stream1_mem : (tx_request ? stream0_mem : 0);
    dma_write = rx_request;
    dma_write_data = rx_request ? rx_word : 0;
    tx_transfer = tx_request && dma_grant;
    rx_transfer = rx_request && dma_grant;
    write_tx_register = sai0_write && address == SAI_DR_A && !tx_ready;
    emit_slot = serial_active && tx_pending && !rx_pending && slot_cycle == SLOT_LAST_CYCLE;

    wire {
        next_pcm[32];
    }
    STM32H750DaisyCodec(frames, right_slot, next_pcm);
    output_left = out_l;
    output_right = out_r;
    frame_count = frames;
    input_left = in_l;
    input_right = in_r;

    clock(clk, 10kHz) {
        if (reset) {
            clear {
                gcr, pdmcr, pdmdly, mux0, mux1, tx_pending, rx_pending, tx_word, rx_word, slot_cycle,
                right_slot, out_l, out_r, in_l, in_r, frames
            };
        } else {
            if (sai_enabled && sai_common && write_enable) {
                switch (address) {
                    case SAI_GCR: gcr = write_data; break;
                    case SAI_PDMCR: pdmcr = write_data; break;
                    case SAI_PDMDLY: pdmdly = write_data; break;
                    default: break;
                }
            }
            if (dma_enabled && mux_mapped && write_enable) {
                if (address == MUX_C0CR) { mux0 = write_data; }
                if (address == MUX_C1CR) { mux1 = write_data; }
            }
            if (tx_transfer || write_tx_register) {
                tx_word = (tx_transfer ? dma_read_data : write_data) & PCM_MASK;
                tx_pending = 1;
            } else if (sai0_flush || !sai_enabled) { tx_pending = 0; }
            if (rx_transfer || sai1_flush || !codec_reset_n || !sai_enabled) { rx_pending = 0; }

            if (!serial_active) {
                clear { slot_cycle, right_slot };
            } else if (emit_slot) {
                slot_cycle = 0;
                right_slot = !right_slot;
                tx_pending = 0;
                rx_pending = 1;
                rx_word = next_pcm;
                if (right_slot) {
                    frames = frames + 1;
                    out_r = tx_word;
                    in_r = next_pcm;
                } else {
                    out_l = tx_word;
                    in_l = next_pcm;
                }
            } else if (slot_cycle != SLOT_LAST_CYCLE) { slot_cycle = slot_cycle + 1; }
        }
    }
}
