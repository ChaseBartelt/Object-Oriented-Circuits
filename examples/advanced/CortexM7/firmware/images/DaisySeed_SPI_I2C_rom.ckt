// BEGIN LINKED FIRMWARE
chip M7FirmwareRomBank(offset, contents, line_data) {
    input {
        offset[4], contents[2048];
    }
    output {
        line_data[128];
    }
    const ZERO11[11] = 0;
    line_shift[11] = (ZERO11 + offset) << 7;
    line_data = contents >> line_shift;
}

chip M7FirmwareRom(address, word, valid) {
    input {
        address[32];
    }
    output {
        word[32];
        valid;
    }
    const ZERO7[7] = 0;
    image_offset[32] = address - 134217728;
    offset[4] = image_offset[7:4];
    shift[7] = (ZERO7 + address[3:2]) << 5;
    bank[6] = image_offset[13:8];
    wire {
        selected_line[128];
    }
    valid = address >= 134217728 && address < 134227652 && address[1:0] == 0;
    const BANK_COUNT[32] = 39;
    const bank_data0[2048] = ;
    const bank_data1[2048] = ;
    const bank_data2[2048] = ;
    const bank_data3[2048] = ;
    const bank_data4[2048] = ;
    const bank_data5[2048] = ;
    const bank_data6[2048] = ;
    const bank_data7[2048] = ;
    const bank_data8[2048] = ;
    const bank_data9[2048] = ;
    const bank_data10[2048] = ;
    const bank_data11[2048] = ;
    const bank_data12[2048] = ;
    const bank_data13[2048] = ;
    const bank_data14[2048] = ;
    const bank_data15[2048] = ;
    const bank_data16[2048] = ;
    const bank_data17[2048] = ;
    const bank_data18[2048] = ;
    const bank_data19[2048] = ;
    const bank_data20[2048] = ;
    const bank_data21[2048] = ;
    const bank_data22[2048] = ;
    const bank_data23[2048] = ;
    const bank_data24[2048] = ;
    const bank_data25[2048] = ;
    const bank_data26[2048] = ;
    const bank_data27[2048] = ;
    const bank_data28[2048] = ;
    const bank_data29[2048] = ;
    const bank_data30[2048] = ;
    const bank_data31[2048] = ;
    const bank_data32[2048] = ;
    const bank_data33[2048] = ;
    const bank_data34[2048] = ;
    const bank_data35[2048] = ;
    const bank_data36[2048] = ;
    const bank_data37[2048] = ;
    const bank_data38[2048] = ;
    for (int i = 0; i < BANK_COUNT; i++) {
        wire {
            bank_line*{i}[128];
        }
        M7FirmwareRomBank(offset, bank_data*{i}, bank_line*{i});
    }
    switch (bank) {
        case 0: selected_line = bank_line0; break;
        case 1: selected_line = bank_line1; break;
        case 2: selected_line = bank_line2; break;
        case 3: selected_line = bank_line3; break;
        case 4: selected_line = bank_line4; break;
        case 5: selected_line = bank_line5; break;
        case 6: selected_line = bank_line6; break;
        case 7: selected_line = bank_line7; break;
        case 8: selected_line = bank_line8; break;
        case 9: selected_line = bank_line9; break;
        case 10: selected_line = bank_line10; break;
        case 11: selected_line = bank_line11; break;
        case 12: selected_line = bank_line12; break;
        case 13: selected_line = bank_line13; break;
        case 14: selected_line = bank_line14; break;
        case 15: selected_line = bank_line15; break;
        case 16: selected_line = bank_line16; break;
        case 17: selected_line = bank_line17; break;
        case 18: selected_line = bank_line18; break;
        case 19: selected_line = bank_line19; break;
        case 20: selected_line = bank_line20; break;
        case 21: selected_line = bank_line21; break;
        case 22: selected_line = bank_line22; break;
        case 23: selected_line = bank_line23; break;
        case 24: selected_line = bank_line24; break;
        case 25: selected_line = bank_line25; break;
        case 26: selected_line = bank_line26; break;
        case 27: selected_line = bank_line27; break;
        case 28: selected_line = bank_line28; break;
        case 29: selected_line = bank_line29; break;
        case 30: selected_line = bank_line30; break;
        case 31: selected_line = bank_line31; break;
        case 32: selected_line = bank_line32; break;
        case 33: selected_line = bank_line33; break;
        case 34: selected_line = bank_line34; break;
        case 35: selected_line = bank_line35; break;
        case 36: selected_line = bank_line36; break;
        case 37: selected_line = bank_line37; break;
        case 38: selected_line = bank_line38; break;
        default: selected_line = 0;
    }
    word = valid ? (selected_line >> shift) : 0;
}
// END LINKED FIRMWARE
