    }
    switch (page_select) {
        case 0: group5 = page80; break;
        case 1: group5 = page81; break;
        case 2: group5 = page82; break;
        case 3: group5 = page83; break;
        case 4: group5 = page84; break;
        case 5: group5 = page85; break;
        case 6: group5 = page86; break;
        case 7: group5 = page87; break;
        default: group5 = 0;
    }
    switch (group_select) {
        case 0: selected = group0; break;
        case 1: selected = group1; break;
        case 2: selected = group2; break;
        case 3: selected = group3; break;
        case 4: selected = group4; break;
        case 5: selected = group5; break;
        default: selected = 0;
    }
    word = valid ? selected >> shift : 0;
}
// END LINKED FIRMWARE
