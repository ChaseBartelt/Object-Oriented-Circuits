                }
            } else if (vector_read) {
                if (bus_valid && bus_data[0]) {
                    current_pc = bus_data & THUMB_ADDRESS;
                    if (frame_psp) { process_stack = frame_address; }
                    else { main_stack = frame_address; }
                    link = ((in_handler ? RETURN_HANDLER_MSP : (frame_psp ? RETURN_THREAD_PSP : RETURN_THREAD_MSP)) &
                           (frame_has_fp ? EXC_RETURN_FP_MASK : 4294967295));
                    fp_context = 0;
                    if (in_handler) { suspended[active_depth - 1] = ipsr; }
                    active_exception = entry_exception;
                    active_set = active_set | (ONE256 << entry_exception);
                    active_depth += 1;
                    clear { it_state, exception_phase };
                } else { failure = 6; }
            } else if (returning) {
                // Restore the saved context and unwind the active exception stack.
                if (!bus_valid) {
                    failure = 4;
                } else if (exception_index < LAST_CORE_WORD) {
                    if (exception_index == 5) { link = bus_data; }
                    if (exception_index == 6) { return_pc = bus_data & THUMB_ADDRESS; }
                    exception_index += 1;
                } else if (exception_index == LAST_CORE_WORD && !(return_status[24] && valid_stacked_mode)) {
                    failure = 6;
                } else if (return_complete) {
                    current_pc = return_pc;
                    flags = return_status[31:28];
                    saturation = return_status[27];
                    ge_flags = return_status[19:16];
                    it_state[7:2] = return_status[15:10];
                    it_state[1:0] = return_status[26:25];
                    if (frame_psp) { process_stack = returned_stack; }
                    else { main_stack = returned_stack; }
                    fp_context = frame_has_fp;
                    if (discard_lazy) { lazy_pending = 0; }
                    active_exception = return_handler ? expected_resume : 0;
                    active_set = active_set & (ALL_EXCEPTIONS ^ (ONE256 << ipsr));
                    active_depth -= 1;
                    exception_phase = 0;
                    retired_pc = current_pc;
                    retired_ir = ir;
                    retire_count += 1;
                } else {
                    if (exception_index == LAST_CORE_WORD) { saved_return_status = bus_data; }
                    exception_index += 1;
                }
            } else if (saving_lazy) {
                // The faulting instruction stays at PC until the deferred writes finish.
                if (!bus_valid) {
                    failure = 4;
                } else if (exception_index == FPSCR_WORD) {
                    clear { lazy_pending, exception_phase };
                } else {
                    exception_index += 1;
                }
            } else if (sleeping) {
                // The timer and NVIC can wake the core without advancing PC here.
            } else if (defer_fp) {
                exception_phase = 5;
                exception_index = 8;
            } else if (skip_instruction) {
                retired_pc = current_pc;
                retired_ir = ir;
                retire_count += 1;
                current_pc = sequential;
                it_state = it_advance;
            } else if (fp_transfer) {
                // Multiword FP transfers keep PC stationary until the last word.
                fp_pending -= 1;
                fp_transfer_index += 1;
                stack_cursor += 4;
                if (fp_transfer_last) {
                    if (fp_core_reg == 13) {
                        if (using_psp) { process_stack = transfer_end; }
                        else { main_stack = transfer_end; }
                    } else if (fp_core_reg == 14) {
                        link = transfer_end;
                    }
                    current_pc = sequential;
                    retired_pc = current_pc;
                    retired_ir = ir;
                    retire_count += 1;
                    it_state = it_advance;
                }
            } else if (pending != 0) {
                pending = remaining;
                stack_cursor = stack_cursor + 4;
                if (stack_lr) { link = bus_data; }
                if (remaining == 0) {
                    if (transfer_wb && rn == 13) {
                        if (using_psp) { process_stack = transfer_end; }
                        else { main_stack = transfer_end; }
                    }
                    if (transfer_wb && rn == 14) { link = transfer_end; }
                    if (return_from_pop) {
                        exception_phase = 3;
                        exception_index = 0;
                        frame_psp = bus_data[2];
                        frame_has_fp = !bus_data[4];
                        return_handler = !bus_data[3];
                        frame_address = bus_data[2] ? psp : msp_after_transfer;
                    } else {
                        current_pc = stack_pc ? (bus_data & THUMB_ADDRESS) : sequential;
                        retired_pc = current_pc;
                        retired_ir = ir;
                        retire_count += 1;
                        it_state = it_advance;
                    }
                }
            } else if (multi_store || multi_load) {
                pending = reg_list;
                stack_cursor = stack_base;
                transfer_end = decrement_before ? stack_base : operand + stack_bytes;
            } else if (fp_store || fp_load) {
                fp_pending = fp_count;
                fp_transfer_index = fp_source;
                stack_cursor = fp_store ? operand - fp_transfer_bytes : operand;
                transfer_end = fp_store ? operand - fp_transfer_bytes : operand + fp_transfer_bytes;
                if (fpccr[31]) { fp_context = 1; }
            } else if (return_from_bx || return_from_memory) {
                exception_phase = 3;
                exception_index = 0;
                frame_psp = exception_return_value[2];
                frame_has_fp = !exception_return_value[4];
                return_handler = !exception_return_value[3];
                frame_address = (exception_return_value[2] ? psp :
                                 memory_base_write && memory_rn == 13 ? memory_next : msp);
                if (memory_base_write && memory_rn == 13) { main_stack = memory_next; }
            } else if (memory_dual && !dual_pending) {
                // Complete the first transfer now and hold PC until the second word is ready.
                // Latch its address before a loaded register can change the base.
                dual_pending = 1;
                stack_cursor = memory_address + 4;
                transfer_end = memory_next;
            } else {
                if (dual_pending) { dual_pending = 0; }
                retired_pc = current_pc;
                retired_ir = ir;
                retire_count += 1;
                it_state = op == 41 ? ir[7:0] : it_advance;
                current_pc = (op == 11 || op == 29 ? (operand & THUMB_ADDRESS) :
                              memory_pc ? (bus_data & THUMB_ADDRESS) : memory_kind == 3 ? table_target :
                              branch_taken ? branch_target : sequential);
                if (op == 10 || op == 29) { link = sequential | 1; }
                else if ((commit_data && exec_rd == 14) || (read_system && sys_register == 14) ||
                         (fp_to_core && fp_core_reg == 14)) { link = write_data; }
                else if (dsp_commit_high && dsp_ra == 14) { link = dsp_high; }
                if (write_fpca && fp_allowed) { fp_context = operand[2]; }
                else if (fp_use && fpccr[31]) { fp_context = 1; }
                if (write_msp) { main_stack = operand & WORD_ADDRESS; }
                if (write_psp) { process_stack = operand & WORD_ADDRESS; }
                if (memory_base_write && memory_rn == 13) {
                    if (using_psp) { process_stack = updated_base & WORD_ADDRESS; }
                    else { main_stack = updated_base & WORD_ADDRESS; }
                } else if (memory_base_write && memory_rn == 14) {
                    link = updated_base;
                }
                if (commit_data && exec_rd == 13) {
                    if (using_psp) { process_stack = write_data & WORD_ADDRESS; }
                    else { main_stack = write_data & WORD_ADDRESS; }
                }
                if (write_apsr) {
                    if (sys_mask[1]) {
                        flags = operand[31:28];
                        saturation = operand[27];
                    }
                    if (sys_mask[0]) { ge_flags = operand[19:16]; }
                } else {
                    if (fp_write_apsr) { flags = fp_effective_status[31:28]; }
                    else if (thumb_active) {
                        if (thumb_flags && (wide || !in_it || exec_rd == 15)) { flags = thumb_next_nzcv; }
                    } else if (!dsp_active && flag_write) { flags = next_nzcv; }
                    if (dsp_active && dsp_ge_write) { ge_flags = dsp_next_ge; }
                    if (dsp_active ? dsp_saturated : saturation_hit) { saturation = 1; }
                }
            }
        }
    }
}

