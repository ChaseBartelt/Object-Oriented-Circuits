// Cortex-M7 execution core: Thumb-2 decoding, integer/DSP/FP datapaths,
// bus transfers, interrupt arbitration, and architectural exception frames.
chip M7FirmwareCore(clk, reset, ir, wide, fetch_ok, fetch_allowed, data_allowed, bus_data, bus_valid, vector_access,
                    irq_pending, pendsv_pending, svc_priority, pendsv_priority, systick_priority, vector_base,
                    sev_on_pend, sleep_on_exit,
                    irq0_enabled, irq0_pending, irq0_priority, irq0_ack, irq0_active, irq0_return,
                    systick_ack, pendsv_ack, irq_active, pending_exception, depth, sleeping, event_latch,
                    raise_fault, set_cfsr, set_hfsr,
                    usagefault_enabled, usagefault_priority, usagefault_active, divzero_trap,
                    memmanage_enabled, memmanage_priority, memmanage_active,
                    busfault_enabled, busfault_priority, busfault_active,
                    pc, msp, psp, sp, lr, nzcv, booted, fault, fault_code, last_pc, last_ir, retired,
                    control, ipsr, primask, basepri, faultmask, privileged, itstate,
                    bus_addr, bus_write_data, bus_read, bus_write, bus_size,
                    r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12,
                    cpacr, fpccr, fpdscr, fpscr, s0, s15, s16, s31, fp_active_frame,
                    fp_lazy_active, fpcar, data_privileged,
                    irq1_pending, irq1_enabled, irq1_priority, irq1_ack, irq1_active, irq1_return,
                    nmi, nmi_set, nmi_pending, nmi_active, priority_group, irq_numbers,
                    external_exception, external_priority, external_active_priority, external_pending_lines,
                    external_ack_lines, external_active_lines, external_return_lines) {
    input clock_reset {
        clk, reset;
    }
    input execution_state {
        wide, ir[32];
    }
    input memory_bus {
        fetch_ok, fetch_allowed, data_allowed, bus_valid, bus_data[32];
    }
    input interrupts {
        irq_pending, pendsv_pending, irq0_enabled, irq0_pending, sev_on_pend, sleep_on_exit, vector_base[32];
        svc_priority[8], pendsv_priority[8], systick_priority[8], irq0_priority[8], irq1_pending;
        irq1_enabled, irq1_priority[8], nmi, nmi_set, priority_group[3], irq_numbers[10];
        external_exception[9], external_priority[8], external_active_priority[8];
        external_pending_lines[240];
    }
    input system_control {
        cpacr[32], fpccr[32], fpdscr[32];
    }
    input fault_handling {
        usagefault_enabled, usagefault_priority[8], divzero_trap, memmanage_enabled, memmanage_priority[8];
        busfault_enabled, busfault_priority[8];
    }
    output execution_state {
        pc[32], msp[32], psp[32], sp[32], lr[32], last_pc[32], last_ir[32], retired[32], nzcv[4], booted;
        itstate[8];
    }
    output memory_bus {
        bus_addr[32], bus_write_data[32], bus_size[2], bus_read, bus_write, vector_access;
    }
    output fault_handling {
        fault_code[3], fault, raise_fault, set_cfsr[32], set_hfsr[32], usagefault_active, memmanage_active;
        busfault_active;
    }
    output system_control {
        control[3], ipsr[9], basepri[8], primask, faultmask, privileged, data_privileged;
    }
    output interrupts {
        pending_exception[9], depth[5], systick_ack, pendsv_ack, irq_active, irq0_ack, irq0_active;
        irq0_return, sleeping, event_latch, irq1_ack, irq1_active, irq1_return, nmi_pending, nmi_active;
        external_ack_lines[240], external_active_lines[240], external_return_lines[240];
    }
    output registers {
        for (int i = 0; i < 13; i++) { r*{i}[32]; }
    }
    output floating_point {
        fpscr[32], s0[32], s15[32], s16[32], s31[32], fp_active_frame, fp_lazy_active, fpcar[32];
    }

    // ARM address masks, EXC_RETURN encodings, frame sizes, and exception IDs.
    const WORD_ADDRESS[32] = 4294967292;
    const THUMB_ADDRESS[32] = 4294967294;
    const FRAME_ALIGN[32] = 4294967288;
    const RETURN_HANDLER_MSP[32] = 4294967281;
    const RETURN_THREAD_MSP[32] = 4294967289;
    const RETURN_THREAD_PSP[32] = 4294967293;
    const BASIC_FRAME[32] = 32;
    const FP_FRAME[32] = 104;
    const EXC_RETURN_BASIC[32] = 16;
    const EXC_RETURN_FP_MASK[32] = 4294967279;
    const FP_DEFAULTS[32] = 130023424;
    const NMI_EXCEPTION[9] = 2;
    const MEMMANAGE[9] = 4;
    const BUSFAULT[9] = 5;
    const USAGEFAULT[9] = 6;
    const LAST_CORE_WORD[5] = 7;
    const FPSCR_WORD[5] = 24;
    const T_BIT[32] = 16777216;
    const ONE4[4] = 1;
    const ONE16[16] = 1;
    const ONE256[256] = 1;
    const ONE240[240] = 1;
    const ALL_EXCEPTIONS[256] = 115792089237316195423570985008687907853269984665640564039457584007913129639935;
    const ALL_REGISTERS[16] = 65535;
    const ZERO32[32] = 0;
    // Stored CPU state; initial values are separate from the clocked reset path.
    phase[2] = 0;
    current_pc[32] = 0;
    main_stack[32] = 0;
    process_stack[32] = 0;
    link[32] = 4294967295;
    flags[4] = 0;
    saturation = 0;
    ge_flags[4] = 0;
    failure[3] = 0;
    retired_pc[32] = 0;
    retired_ir[32] = 0;
    retire_count[32] = 0;

    // Keep PC on the stack instruction until all selected words are transferred.
    pending[16] = 0;
    stack_cursor[32] = 0;
    transfer_end[32] = 0;

    fp_context = 0;
    fp_pending[6] = 0;
    fp_transfer_index[5] = 0;
    dual_pending = 0;
    exclusive_valid = 0;
    exclusive_addr[32] = 0;
    exclusive_size[2] = 0;

    // Both frame formats start with eight core words. FP state follows at offset 32.
    // Thread mode can stack on MSP or PSP. The handler executes on MSP.
    exception_phase[3] = 0;
    exception_index[5] = 0;
    frame_address[32] = 0;
    frame_psp = 0;
    frame_has_fp = 0;
    frame_lazy = 0;
    lazy_pending = 0;
    lazy_address[32] = 0;
    lazy_privileged = 0;
    return_handler = 0;
    return_pc[32] = 0;
    saved_return_status[32] = 0;
    entry_exception[9] = 0;
    active_exception[9] = 0;
    active_set[256] = 0;
    active_depth[5] = 0;
    // Preserve each suspended handler while higher-priority exceptions run.
    suspended[32][9] = 0;
    previous_nmi = 0;
    pending_nmi = 0;
    fault_cause[3] = 0;
    fault_frame_stacked = 0;
    it_state[8] = 0;
    // Internal signals are grouped for schematic inspection and editor folding.
    wire instruction_decode {
        op[6], rd[4], rn[4], rm[4], condition[4], size_code[2], reg_list[16];
        imm[32], gpr_a[32], gpr_b[32], gpr_store[32], gpr_high[32], result[32];
        use_reg, condition_met, transfer_wb;
        in_it, skip_instruction, test_carry, instruction_ok;
        load, store_data, multi_store, multi_load, decrement_before, stack_active, active, execute;
        transfer_last, base_write, stack_lr;
        alu_write, flag_write, stack_pc, commit_data, write_gpr;
        entering, vector_read, returning, exception_busy, exception_bus;
        probing_fault, vector_fault, execution_fault, unaligned_data, frame_bus_error;
        divide_fault, take_configurable_fault, configurable_enabled;
        restore_gpr;
        next_nzcv[4];
    }
    wire system_exceptions {
        system_op[3], sys_selector[8], sys_register[4], sys_mask[2];
        system_read[32];
        system_valid, write_msp, write_psp, write_apsr, thread_psp;
        in_handler, supported, read_system, using_psp, return_complete;
        systick_eligible, pendsv_eligible, svc_eligible, take_pending, take_svc;
        fixed_priority_active, nmi_accepted, clear_faultmask;
        return_from_pop, return_from_bx, returns_to_thread, priority_pass, valid_stacked_mode;
    }
    wire floating_point {
        fp_op[5], fp_core_reg[4], fp_dest[5], fp_source[5], fp_other[5], fp_count[6];
        fp_read_index[5], fp_write_index[5], frame_fp_index[5];
        fp_data[32], fp_second[32], fp_accumulator[32], fp_write_data[32], fp_status_data[32];
        fp_add_result[32], fp_add_status[32];
        fp_sqrt_result[32], fp_sqrt_status[32], fp_fused_result[32], fp_fused_status[32];
        fp_muldiv_result[32], fp_muldiv_status[32], fp_cmp_status[32], fp_cvt_result[32], fp_cvt_status[32];
        fp_store, fp_load, fp_transfer, fp_allowed, fp_denied, fp_use, fp_to_core;
        fp_write, fpscr_write, fp_restore, fp_restore_reg, fp_transfer_last, write_fpca;
        fp_divide, fp_muldiv, fp_to_int, fp_int_signed, fp_memory, fp_read_word, fp_write_word, fp_math, fp_write_apsr;
        fp_compare_zero, fp_signal_nan, fp_round_zero, fp_select_first;
        fp_negate_product, fp_negate_accumulator, fp_accumulate;
        saving_lazy, defer_fp, discard_lazy, fp_first_use;
    }
    wire integer_datapath {
        expanded_imm[32], multiply_product[32], thumb_value[32], thumb_result[32], dsp_result[32], dsp_high[32];
        thumb_kind[5], thumb_rd[4], thumb_rn[4], thumb_rm[4], thumb_ra[4], thumb_shift[5], thumb_shift_type[2];
        dsp_op[4], dsp_rd[4], dsp_rn[4], dsp_rm[4], dsp_ra[4], dsp_aux[13], dsp_next_ge[4], thumb_next_nzcv[4];
        thumb_reg_shift, thumb_immediate, thumb_immediate_carry, thumb_flags, thumb_active;
        dsp_active, dsp_long, dsp_commit_high, dsp_saturated, dsp_ge_write;
    }
    wire memory_transfers {
        memory_kind[2], memory_rn[4], memory_rm[4], memory_rt[4], memory_rt2[4], memory_size[2], memory_shift[2];
        memory_offset[12];
        memory_indexed, memory_negate, memory_preindex, memory_writeback, memory_signed;
        memory_dual, memory_unprivileged;
        memory_exclusive_load, memory_exclusive_store, exclusive_pass, clear_exclusive;
        exclusive_status_reg[4];
        memory_active, memory_read, memory_write, memory_load, memory_pc, memory_base_write, return_from_memory;
        compare_branch, wide_conditional, branch_taken, direct_load, direct_store;
    }
    // Parallel decoders select the active instruction family.
    M7FirmwareDecode(ir, op, rd, rn, rm, imm, use_reg, condition, size_code, reg_list, transfer_wb, expanded_imm);
    wire arithmetic_flags {
        saturation_hit;
    }
    M7FirmwareALU(op, operand, rhs, instruction_condition, nzcv, test_carry,
                  result, next_nzcv, condition_met, saturation_hit, multiply_product);
    M7ThumbDataDecode(ir, expanded_imm, thumb_kind, thumb_rd, thumb_rn, thumb_rm, thumb_ra, thumb_value,
                      thumb_shift_type, thumb_shift, thumb_reg_shift, thumb_immediate, thumb_immediate_carry, thumb_flags);
    M7ThumbData(thumb_kind, thumb_operand, reg_b, reg_c, multiply_product, thumb_value, thumb_shift_type,
                thumb_shift, thumb_reg_shift, thumb_immediate, thumb_immediate_carry, nzcv, thumb_result, thumb_next_nzcv);
    M7DSPDecode(ir, dsp_op, dsp_rd, dsp_rn, dsp_rm, dsp_ra, dsp_aux);
    M7DSPExecute(dsp_op, dsp_operand, dsp_rhs, dsp_accumulate, dsp_accumulate_high, dsp_aux, ge_flags,
                 dsp_result, dsp_high, dsp_saturated, dsp_ge_write, dsp_next_ge);
    M7ThumbMemoryDecode(ir, memory_kind, memory_rn, memory_rm, memory_rt, memory_rt2, memory_size, memory_offset,
                        memory_shift, memory_indexed, memory_negate, memory_preindex, memory_writeback,
                        memory_signed, memory_dual, memory_unprivileged, memory_exclusive_load, memory_exclusive_store,
                        exclusive_status_reg);
    M7SystemDecode(ir, system_op, sys_selector, sys_register, sys_mask);
    M7SystemRegisters(clk, reset, execute, system_op, sys_selector, sys_mask, operand,
                      in_handler, clear_faultmask, returns_to_thread, frame_psp,
                      ipsr, apsr, msp, psp, system_read, system_valid, write_msp, write_psp,
                      write_apsr, privileged, thread_psp, primask, basepri, faultmask, control,
                      fp_context, write_fpca);
    M7FirmwareRegisters(clk, reset, write_gpr, write_index, write_data,
                        base_write, transfer_base_reg, updated_base,
                        read_index, read_b_index, read_store_index, read_high_index,
                        gpr_a, gpr_b, gpr_store, gpr_high,
                        r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12);
    // Floating-point registers and arithmetic retain bit-level FPSCR behavior.
    M7FPDecode(ir, fp_op, fp_core_reg, fp_dest, fp_source, fp_other, fp_count);
    M7FPRegisters(clk, reset, fp_read_index, fp_other, fp_accumulator_index, fp_write, fp_write_index, fp_write_data,
                  fpscr_write, fp_status_data, fp_data, fp_second, fp_accumulator, fpscr, s0, s15, s16, s31);
    M7FPAdd(fp_add_lhs, fp_add_rhs, fp_add_input_status, fp_add_result, fp_add_status);
    M7FPMulDiv(fp_muldiv_left, fp_muldiv_right, fp_effective_status, fp_divide, fp_muldiv_result, fp_muldiv_status);
    M7FPCompare(fp_data, fp_second, fp_effective_status, fp_compare_zero, fp_signal_nan, fp_cmp_status);
    M7FPConvert(fp_second, fp_effective_status, fp_to_int, fp_int_signed, fp_round_zero, fp_cvt_result, fp_cvt_status);
    M7FPSqrt(fp_sqrt_operand, fp_effective_status, fp_sqrt_result, fp_sqrt_status);
    M7FPFused(fp_fused_left, fp_fused_right, fp_fused_addend, fp_effective_status,
              fp_negate_product, fp_negate_accumulator, fp_fused_result, fp_fused_status);

    // Publish architectural registers and the instruction-retirement trace.
    pc = current_pc;
    msp = main_stack;
    psp = process_stack;
    sp = using_psp ? psp : msp;
    using_psp = !in_handler && thread_psp;
    lr = link;
    nzcv = flags;
    itstate = it_state;
    in_it = it_state[3:0] != 0;
    instruction_condition[4] = in_it ? it_state[7:4] : (wide_conditional ? ir[9:6] : condition);
    instruction_ok = fetch_ok && fetch_allowed;
    skip_instruction = in_it && !condition_met && instruction_ok && !sleeping;
    it_advance[8] = it_state[2:0] == 0 ? 0 : ((it_state & 224) | ((it_state << 1) & 31));
    test_carry = ir[10] || ir[30] ? imm[31] : nzcv[1];
    ipsr = active_exception;
    depth = active_depth;
    in_handler = active_exception != 0;
    wire processor_status {
        apsr[9];
    }
    apsr[8:5] = flags;
    apsr[4] = saturation;
    apsr[3:0] = ge_flags;
    booted = phase == 2;
    fault_code = failure;
    fault = failure != 0;
    last_pc = retired_pc;
    last_ir = retired_ir;
    retired = retire_count;
    irq_active = in_handler;
    entering = exception_phase == 1;
    vector_read = exception_phase == 2;
    returning = exception_phase == 3;
    probing_fault = exception_phase == 4;
    saving_lazy = exception_phase == 5;
    vector_access = !booted || vector_read || probing_fault;
    exception_busy = exception_phase != 0;
    exception_bus = !reset && !fault && exception_busy;
    // Group comparisons ignore priority bits [PRIGROUP:0]. Pending arbitration
    // still compares the full priority byte, so subpriority breaks a group tie.
    // Apply PRIGROUP and masking before comparing pending exception priorities.
    group_shift[4] = ONE4 + priority_group;
    group_mask[8] = 255 << group_shift;
    base_group_priority[8] = basepri & group_mask;
    systick_eligible = irq_pending && !faultmask && (basepri == 0 || (systick_priority & group_mask) < base_group_priority);
    pendsv_eligible = pendsv_pending && !faultmask && (basepri == 0 || (pendsv_priority & group_mask) < base_group_priority);
    // The lower exception number wins when group priority and subpriority tie.
    tick_candidate[9] = (pendsv_eligible && (!systick_eligible || pendsv_priority <= systick_priority) ? 14 :
                        (systick_eligible ? 15 : 0));
    tick_priority[8] = tick_candidate == 14 ? pendsv_priority : systick_priority;
    const ZERO9[9] = 0;
    irq0_exception[9] = ZERO9 + irq_numbers[4:0] + 16;
    irq1_exception[9] = ZERO9 + irq_numbers[9:5] + 16;
    // NVIC has already selected the lowest-priority code and IRQ-number tie.
    external_candidate[9] = (external_exception != 0 && !faultmask &&
                             (basepri == 0 || (external_priority & group_mask) < base_group_priority) ?
                             external_exception : 0);
    external_pending_priority[8] = external_priority;
    pending_exception = (pending_nmi ? NMI_EXCEPTION :
                         external_candidate != 0 && (tick_candidate == 0 || external_pending_priority < tick_priority) ?
                         external_candidate : tick_candidate);
    pending_priority[8] = pending_exception >= 16 ? external_pending_priority : tick_priority;
    // The execution priority includes suspended handlers, whose priorities can
    // change while a nested handler is running. Find the lowest active code.
    wire active_priority_tree {
        active_priorities[64], pair_priority[32], quad_priority[16];
    }
    active_priorities[7:0] = active_set[4] ? memmanage_priority : 255;
    active_priorities[15:8] = active_set[5] ? busfault_priority : 255;
    active_priorities[23:16] = active_set[6] ? usagefault_priority : 255;
    active_priorities[31:24] = active_set[11] ? svc_priority : 255;
    active_priorities[39:32] = active_set[14] ? pendsv_priority : 255;
    active_priorities[47:40] = active_set[15] ? systick_priority : 255;
    wire nested_irq_state {
        irq0_stacked, irq1_stacked;
    }
    irq0_stacked = ((active_set >> irq0_exception) & 1) != 0;
    irq1_stacked = ((active_set >> irq1_exception) & 1) != 0;
    active_priorities[55:48] = external_active_priority;
    active_priorities[63:56] = 255;
    for (int i = 0; i < 4; i++) {
        pair_priority[i * 8 + 7 : i * 8] =
            (active_priorities[i * 16 + 7 : i * 16] < active_priorities[i * 16 + 15 : i * 16 + 8] ?
             active_priorities[i * 16 + 7 : i * 16] : active_priorities[i * 16 + 15 : i * 16 + 8]);
    }
    for (int i = 0; i < 2; i++) {
        quad_priority[i * 8 + 7 : i * 8] =
            (pair_priority[i * 16 + 7 : i * 16] < pair_priority[i * 16 + 15 : i * 16 + 8] ?
             pair_priority[i * 16 + 7 : i * 16] : pair_priority[i * 16 + 15 : i * 16 + 8]);
    }
    active_priority[8] = quad_priority[7:0] < quad_priority[15:8] ? quad_priority[7:0] : quad_priority[15:8];
    active_group_priority[8] = active_priority & group_mask;
    fixed_priority_active = active_set[2] || active_set[3];
    priority_pass = (pending_exception == NMI_EXCEPTION || !in_handler ||
                     (!fixed_priority_active && (pending_priority & group_mask) < active_group_priority));
    wire interrupt_wakeup {
        interrupt_ready, hint_recognized;
    }
    interrupt_ready = (!reset && booted && !fault && pending_exception != 0 &&
                       priority_pass && !exception_busy && !stack_active && !dual_pending &&
                       ((active_set >> pending_exception) & 1) == 0);
    // PRIMASK masks configurable exceptions and permits them to wake WFI.
    take_pending = interrupt_ready && (!primask || pending_exception == NMI_EXCEPTION);
    wire pending_event_lines {
        pending_lines[243];
    }
    pending_lines[0] = irq_pending;
    pending_lines[1] = pendsv_pending;
    pending_lines[2] = pending_nmi;
    pending_lines[242:3] = external_pending_lines;
    // The low-power hint controller can stall execution while interrupts continue.
    M7ThumbHints(clk, reset, ir, wide, execute, interrupt_ready, take_pending, pending_lines,
                 return_complete, returns_to_thread, sev_on_pend, sleep_on_exit,
                 hint_recognized, sleeping, event_latch);
    systick_ack = take_pending && pending_exception == 15;
    pendsv_ack = take_pending && pending_exception == 14;
    irq0_ack = take_pending && pending_exception == irq0_exception;
    irq0_active = irq0_stacked || ((entering || vector_read) && entry_exception == irq0_exception);
    irq0_return = return_complete && ipsr == irq0_exception;
    irq1_ack = take_pending && pending_exception == irq1_exception;
    irq1_active = irq1_stacked || ((entering || vector_read) && entry_exception == irq1_exception);
    irq1_return = return_complete && ipsr == irq1_exception;
    pending_irq_index[8] = pending_exception - 16;
    entering_irq_index[8] = entry_exception - 16;
    returning_irq_index[8] = ipsr - 16;
    external_ack_lines = take_pending && pending_exception >= 16 ? ONE240 << pending_irq_index : 0;
    external_active_lines = (active_set >> 16) | ((entering || vector_read) && entry_exception >= 16 ?
                             ONE240 << entering_irq_index : 0);
    external_return_lines = return_complete && ipsr >= 16 ? ONE240 << returning_irq_index : 0;
    nmi_accepted = take_pending && pending_exception == NMI_EXCEPTION;
    nmi_pending = pending_nmi;
    nmi_active = active_set[2] || ((entering || vector_read) && entry_exception == NMI_EXCEPTION);
    svc_group_priority[8] = svc_priority & group_mask;
    svc_eligible = ((!in_handler || (!fixed_priority_active && svc_group_priority < active_group_priority && !active_set[11])) &&
                    !primask && !faultmask && (basepri == 0 || svc_group_priority < base_group_priority));
    resume_index[5] = active_depth >= 2 ? active_depth - 2 : 0;
    expected_resume[9] = suspended[resume_index];
    return_status[32] = exception_index == LAST_CORE_WORD ? bus_data : saved_return_status;
    valid_stacked_mode = (return_handler ? (active_depth >= 2 && return_status[8:0] == expected_resume) :
                          (active_depth == 1 && return_status[8:0] == 0));
    return_complete = (returning && !reset && !fault && bus_valid &&
                       exception_index == (fp_restore ? FPSCR_WORD : LAST_CORE_WORD) &&
                       return_status[24] && valid_stacked_mode);
    returns_to_thread = return_complete && !return_handler;
    clear_faultmask = return_complete && ipsr != NMI_EXCEPTION;
    pop_return_kind[32] = bus_data | EXC_RETURN_BASIC;
    bx_return_kind[32] = operand | EXC_RETURN_BASIC;
    wire exception_return_check {
        loaded_return;
    }
    loaded_return = (in_handler && (pop_return_kind == RETURN_THREAD_MSP ||
                     pop_return_kind == RETURN_THREAD_PSP || pop_return_kind == RETURN_HANDLER_MSP));
    return_from_pop = stack_pc && loaded_return;
    return_from_memory = memory_pc && loaded_return;
    return_from_bx = (op == 11 && in_handler && (bx_return_kind == RETURN_THREAD_MSP ||
                      bx_return_kind == RETURN_THREAD_PSP || bx_return_kind == RETURN_HANDLER_MSP));
    // Thumb PC-relative addressing, conditional branches, and sequential fetch.
    pc_ahead[32] = pc + 4;
    sequential[32] = pc + (wide ? 4 : 2);
    compare_branch = (ir[15:0] & 62720) == 45312;
    wide_conditional = ir[15:11] == 30 && (ir[31:16] & 53248) == 32768 && ir[9:6] < 14;
    wire wide_branch_offset {
