# DE10-Lite unsigned 4-bit ALU with registered results, 50 MHz clock.
# A = SW3..SW0; B = SW7..SW4. SW0/SW4 are the least significant bits.
# Opcode SW9:SW8: 00 add, 01 subtract A-B, 10 bitwise XOR, 11 compare A<B.
# LEDR3..0 = result modulo 16; compare produces 0 or 1 in LEDR0.
# LEDR4 = add carry or subtract borrow; it is zero for XOR and compare.
# LEDR5 = low four result bits are zero; LEDR6 = A==B; LEDR7 = A<B.
# LEDR9:LEDR8 = opcode captured with the displayed result.
# Examples: 15+1 gives 0 with carry=1; 3-5 gives 14 with borrow=1;
# 10 XOR 12 gives 6; compare 3<5 gives 1. All arithmetic is unsigned.
# Input words use explicit 4-bit wires; ZERO5 widens arithmetic BEFORE adding
# or subtracting, so the carry/borrow is retained in the 5-bit result register.
# Addition builds the input words without unsupported shifts or concatenation.
# Each switch is automatically synchronized by the DE10-Lite profile. A stable
# switch change reaches registered results after three rising clock edges.
# There is no reset input: all ten switches are operands/opcode. Initial
# registers start at zero; status flags settle on the first clock edge.
# No debounce, atomic multi-switch capture, external files, or hardware testing.

chip HYBRID01(MAX10_CLK1_50, SW0, SW1, SW2, SW3, SW4, SW5, SW6, SW7, SW8, SW9, LEDR0, LEDR1, LEDR2, LEDR3, LEDR4, LEDR5, LEDR6, LEDR7, LEDR8, LEDR9) {
    MAX10_CLK1_50, SW0, SW1, SW2, SW3, SW4, SW5, SW6, SW7, SW8, SW9 = input;
    LEDR0, LEDR1, LEDR2, LEDR3, LEDR4, LEDR5, LEDR6, LEDR7, LEDR8, LEDR9 = output;

    const ZERO4[4] = 0;
    const ZERO5[5] = 0;
    a_pair[4], a_triple[4], operand_a[4] = wire;
    b_pair[4], b_triple[4], operand_b[4] = wire;
    next_result[5] = wire;
    result[5] = 0;
    zero_flag;
    equal_flag;
    less_flag;
    opcode_low;
    opcode_high;

    a_pair = ZERO4 + SW3 + SW3 + SW2;
    a_triple = a_pair + a_pair + SW1;
    operand_a = a_triple + a_triple + SW0;
    b_pair = ZERO4 + SW7 + SW7 + SW6;
    b_triple = b_pair + b_pair + SW5;
    operand_b = b_triple + b_triple + SW4;

    if (!SW9 && !SW8) {
        next_result = ZERO5 + operand_a + operand_b;
    } else if (!SW9 && SW8) {
        next_result = ZERO5 + operand_a - operand_b;
    } else if (SW9 && !SW8) {
        next_result = operand_a ^ operand_b;
    } else {
        next_result = operand_a < operand_b;
    }

    clock(MAX10_CLK1_50, 50MHz) {
        result = next_result;
        zero_flag = (next_result & 15) == 0;
        equal_flag = operand_a == operand_b;
        less_flag = operand_a < operand_b;
        opcode_low = SW8;
        opcode_high = SW9;
    }

    LEDR0 = result[0];
    LEDR1 = result[1];
    LEDR2 = result[2];
    LEDR3 = result[3];
    LEDR4 = result[4];
    LEDR5 = zero_flag;
    LEDR6 = equal_flag;
    LEDR7 = less_flag;
    LEDR8 = opcode_low;
    LEDR9 = opcode_high;
}
