# HYBRID-01 | Stereo LT1677 output with headphone jack
# DE10-Lite FPGA +5V power -> two LT1677s
# Daisy Seed3 audio out 1/2 -> left/right audio inputs
# 3.5 mm TRS headphone jack: tip = left, ring = right, sleeve = ground
#
# No FPGA or Daisy chip/processor models: only their named connection
# wires and temporary ideal voltage sources for OOC simulation.
#
# Real-world supply and signal connections:
#   fpga_5v           = +5V POWER pin from DE10-Lite (NOT a GPIO)
#   0                 = common ground: FPGA, Daisy AGND, amplifier, jack
#   daisy_audio_out1  = Daisy audio output 1 (left)
#   daisy_audio_out2  = Daisy audio output 2 (right)
#   jack_tip          = left output to the headphone jack
#   jack_ring         = right output to the headphone jack
#   jack_sleeve       = common ground (represented by node 0)
#
# Check the physical TRS jack pin mapping with a continuity meter.

include("LT1677");

# SCHEMATIC-ONLY BOARD/INTERFACE SYMBOLS.
# These create visible packages but do not add any electrical behavior.
# The ideal VfpgaPower and VdaisyLeft/Right sources below drive the test.
chip DE10LitePower(plus5, ground) {
    R1(10) between (plus5, ground);
}

chip DaisySeed3Audio(left, right, ground)  {
    R1(10) between (left, right);
}

f = 1k;

# ============================================================
# SIMULATION-ONLY SOURCES (not models of the actual boards)
# ============================================================
# Represent the FPGA's dedicated 5V supply output.
VfpgaPower(5V) between(fpga_5v, 0);

# Represent the Daisy's two analog audio outputs.
# Deliberately different levels to make stereo separation obvious.
VdaisyLeft(0.1 Vrms) between(daisy_audio_out1, 0);
VdaisyRight(0.05 Vrms) between(daisy_audio_out2, 0);

# When building the physical circuit, these ideal voltage-source
# symbols are replaced by the corresponding real board connections.

# ============================================================
# SHARED 2.5V REFERENCE FOR SINGLE-SUPPLY OP-AMPS
# ============================================================
# Two 10k resistors divide the FPGA 5V rail in half.
RbiasTop(10k) between(fpga_5v, vref_2v5);
RbiasBottom(10k) between(vref_2v5, 0);
Cref(10uF) between(vref_2v5, 0);
CrefHF(100nF) between(vref_2v5, 0);

# ============================================================
# FIVE-PIN TRS JACK: passive connector with no internal model
# ============================================================
# Pin order is based on your latest OOC symbol:
# 1=sleeve, 2=ring, 3=aux, 4=aux, 5=tip.
# Confirm this mapping on your physical jack before connecting.
chip HeadphoneJack5(sleeve, ring, aux3, aux4, tip) {
 R4(10) between(tip, sleeve);
}

# ============================================================
# ONE LT1677 AUDIO CHANNEL (reused twice)
# ============================================================
circuit AudioChannel(source, amplifier_out, line_out,
                     positive_supply, bias, ground) {

    # Existing input capacitors: 3 x 560nF in parallel = 1.68uF.
    C1(560nF) between(source, coupled);
    C2(560nF) between(source, coupled);
    C3(560nF) between(source, coupled);

    # Inverting voltage gain = -(10k / 10k) = -1.
    # Change feedback to 20k only if additional gain is needed.
    Rin(10k) between(coupled, minus);
    Rfeedback(10k) between(amplifier_out, minus);

    # LT1677 DIP/SOIC physical pins, 1 to 8:
    # 1 trim; 2 minus; 3 plus; 4 V-;
    # 5 NC; 6 out; 7 V+; 8 trim.
    # Single 5V supply: pin 7=+5V, pin 4=GND,
    # pin 3=2.5V bias (NOT ground).
    LT1677(trim1, minus, bias, ground,
           nc5, amplifier_out, positive_supply, trim8);

    # Local supply bypass capacitor: one per amplifier.
    Cdecouple(100nF) between(positive_supply, ground);

    # The output rests near 2.5V DC. This capacitor blocks that DC
    # from the jack; positive side faces amplifier_out if polarized.
    Coutput(10uF) between(amplifier_out, line_out);
}

# ============================================================
# BOTH LEFT AND RIGHT CHANNELS
# ============================================================
main {
    # FPGA and Daisy connection symbols; the ideal sources above drive the nets.
    //DE10LitePower(fpga_5v, 0);
    //DaisySeed3Audio(daisy_audio_out1, daisy_audio_out2, 0);

    AudioChannel(daisy_audio_out1, amp_left, jack_tip,
                 fpga_5v, vref_2v5, 0);

    AudioChannel(daisy_audio_out2, amp_right, jack_ring,
                 fpga_5v, vref_2v5, 0);

    # Pin 1 sleeve, pin 2 ring, pin 5 tip.
    //HeadphoneJack5(0, jack_ring, unused_aux3, unused_aux4, jack_tip);

    # Supply and reference checks
    measure = V fpga_5v 0;
    measure = V vref_2v5 0;

    # Daisy test sources, LT1677 outputs, and headphone jack outputs
    measure = V daisy_audio_out1 0;
    measure = V daisy_audio_out2 0;
    measure = V amp_left 0;
    measure = V amp_right 0;
    measure = V jack_tip 0;
    measure = V jack_ring 0;
    perf[A-R,1-24] exclude[VfpgaPower, VdaisyLeft, VdaisyRight];
}


