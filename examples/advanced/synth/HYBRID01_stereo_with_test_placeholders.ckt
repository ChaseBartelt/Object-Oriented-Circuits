# HYBRID-01 Single Channel Audio Output

include("LT1677");


f = 1k;

# FPGA power supply
Vfpga(5V | 0<0 Vpk) between(fpga_5v, 0);

# Daisy Seed3 audio output
VdaisyL(0V | 0.5 Vrms) between(daisy_left, 0);

chip StereoJack5(sleeve, ring, aux3, aux4, tip) {
    RtestL(10k) between(tip, sleeve);
}

main {

    # Shared 2.5V voltage reference
    Rbias1(10k) between(fpga_5v, vref);
    Rbias2(10k) between(vref, 0);
    Cbias(100u) between(vref, 0);

    # Input capacitors
    parallel(daisy_left, left_in) {
        CL1(560n);
        CL2(560n);
        CL3(560n);
    }

    RbiasL(47k) between(left_in, vref);

    # LT1677 unity-gain buffer
    LT1677(
        trim1,
        left_amp,
        left_in,
        0,
        nc5,
        left_amp,
        fpga_5v,
        trim8
    );

    # Power decoupling
    Cpower(100n) between(fpga_5v, 0);

    # Output coupling
    series(left_amp, jack_tip) {
        Routput(220);
        Coutput(10u);
    }

    Rdischarge(100k) between(jack_tip, 0);

    # Output jack
    StereoJack5(0, unused2, unused3, unused4, jack_tip);

    measure = V vref 0;
    measure = V left_amp 0;
    measure = V jack_tip 0;
    perf[A-R,1-24] exclude[Vfpga, VdaisyL];
}
