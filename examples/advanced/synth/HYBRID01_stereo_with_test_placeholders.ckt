# HYBRID-01: stereo LT1677 output-stage test
# Uses only *electrical* models for testing. FPGA and Daisy are
# represented by test power/audio sources, not their digital models.
# No saved @ooc-layout metadata: allow OOC to place everything afresh.
# Scarlett LINE INPUT TEST, not a low-impedance headphone driver.
# Verify the physical TRS contact map with a continuity meter.

include("LT1677");

# 1kHz controls the AC audio sources below.
f = 1k;

# IMPORTANT: THIS IS A 5V DC SUPPLY, NOT A 1kHz 5V AC SIGNAL.
# It represents a regulated +5V FPGA power header output.
battery FPGA_5V {
    V = 5;
    wire = fpga_5v;
}

# Simulation-only analog outputs in place of the Daisy Seed3.
VdaisyLeft(0.1 Vrms) between(daisy_audio_out1, 0);
VdaisyRight(0.05 Vrms) between(daisy_audio_out2, 0);

# Shared 2.5V reference and bypass capacitors.
RbiasTop(10k) between(fpga_5v, vref_2v5);
RbiasBottom(10k) between(vref_2v5, 0);
Cref(10uF) between(vref_2v5, 0);
CrefHF(100nF) between(vref_2v5, 0);

# Reusable audio output stage.
# Gain -1, low-voltage source / Scarlett high-Z line load.
circuit AudioChannel(source, amplifier_out, line_out,
                     positive_supply, bias, ground) {

    # 3 x 560nF in parallel = 1.68uF, AC-coupling the source.
    C1(560nF) between(source, coupled);
    C2(560nF) between(source, coupled);
    C3(560nF) between(source, coupled);

    Rin(10k) between(coupled, minus);
    Rfeedback(10k) between(amplifier_out, minus);

    # Physical LT1677 pins 1,2,3,4,5,6,7,8.
    # V+ = 5V, V- = GND, non-inverting input = 2.5V.
    LT1677(trim1, minus, bias, ground,
           nc5, amplifier_out, positive_supply, trim8);

    Cdecouple(100nF) between(positive_supply, ground);

    # DC-block the 2.5V-biased LT1677 output for the Scarlett.
    # For a polarized part, positive terminal toward amplifier_out.
    Coutput(10uF) between(amplifier_out, line_out);
}

# SCHEMATIC CONTAINERS WITH ACTUAL ELECTRICAL CONNECTIONS.
# Their 10M input/monitor resistors are tiny loading approximations,
# not real FPGA, Daisy, or jack internal schematics.
# Every resistor has two explicit pin connections.
chip DE10LitePower(plus5, ground) {
    Rmonitor(10M) between(plus5, ground);
}

chip DaisySeed3Audio(left, right, ground) {
    RleftSense(10M) between(left, ground);
    RrightSense(10M) between(right, ground);
}

# These two 10M shunts make the jack a solvable approximation;
# the actual metal contacts simply map tip/ring/sleeve nodes.
# The AUX contacts are deliberately unused and have no behavior.
chip HeadphoneJack5(sleeve, ring, aux3, aux4, tip) {
    RjackLeft(10M) between(tip, sleeve);
    RjackRight(10M) between(ring, sleeve);
}

main {
    DE10LitePower(fpga_5v, 0);
    DaisySeed3Audio(daisy_audio_out1, daisy_audio_out2, 0);

    AudioChannel(daisy_audio_out1, amp_left, jack_tip,
                 fpga_5v, vref_2v5, 0);
    AudioChannel(daisy_audio_out2, amp_right, jack_ring,
                 fpga_5v, vref_2v5, 0);

    # Headphone jack pins: sleeve/ring/aux3/aux4/tip.
    # Pin names are logical; verify physical contact pin numbers.
    HeadphoneJack5(0, jack_ring, unused_aux3, unused_aux4, jack_tip);

    measure = V fpga_5v 0;
    measure = V vref_2v5 0;
    measure = V daisy_audio_out1 0;
    measure = V daisy_audio_out2 0;
    measure = V amp_left 0;
    measure = V amp_right 0;
    measure = V jack_tip 0;
    measure = V jack_ring 0;
}


