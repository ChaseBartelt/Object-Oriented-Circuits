# Stereo LT1677 audio stage
# One LT1677 per channel.
# Gain approximately -1.
# Outputs feed the headphone-driver stage.

include("LT1677");

f = 1k;

# Power supplies, both referenced to ground.
Vpos(5V) between(vcc, 0);
Vneg(-5V) between(vee, 0);

# Test signals representing the Seed3 audio outputs.
# Left:  Seed3 physical pin 18.
# Right: Seed3 physical pin 19.
Vleft(0.1 Vrms) between(audio_left, 0);
Vright(0.1 Vrms) between(audio_right, 0);

circuit AudioChannel(input, output, positive, negative, ground) {

    # Input DC blocking and input resistance.
    Cinput(2.2uF) between(input, coupled);
    Rin(10k) between(coupled, inverting);

    # Negative feedback and compensation.
    Rfeedback(10k) between(output, inverting);
    Cfeedback(47pF) between(output, inverting);

    # LT1677 physical pin order:
    # 1 trim, 2 minus, 3 plus, 4 negative supply,
    # 5 NC, 6 output, 7 positive supply, 8 trim.
    LT1677(
        trim1,
        inverting,
        ground,
        negative,
        nc5,
        output,
        positive,
        trim8
    );

    # Supply bypass capacitors.
    Cpositive(100nF) between(positive, ground);
    Cnegative(100nF) between(negative, ground);
}

main {

    AudioChannel(
        audio_left, preamp_left,
        vcc, vee, 0
    );

    AudioChannel(
        audio_right, preamp_right,
        vcc, vee, 0
    );

    # Light test loads, representing a following stage.
    # These resistors are not headphone models.
    RloadLeft(10k) between(preamp_left, 0);
    RloadRight(10k) between(preamp_right, 0);

    measure = V preamp_left 0;
    measure = V preamp_right 0;
}
