
# Daisy Seed3 - Left Headphone Amplifier
# One LT1677 and one 5-pin TRS jack
# Nominal voltage gain: -1

include("LT1677");

f = 1k;

# ========================================
# DAISY SEED3 - 40 PHYSICAL PINS
# Pin order follows board pin numbers 1-40
# ========================================

chip DaisySeed3(
    D0, D1, D2, D3, D4,
    D5, D6, D7, D8, D9,
    D10, D11, D12, D13, D14,
    AudioIn1, AudioIn2,
    AudioOut1, AudioOut2, AGND,
    V3A,
    A0, A1, A2, A3, A4, A5,
    A6, A7, A8, A9, A10,
    D26, D27, A11, D29, D30,
    V3D, VIN, DGND
) {
    # Schematic-only pinout.
    # Firmware and internal codec not modeled.
    model = unavailable;
}


# ========================================
# 5-PIN HEADPHONE JACK
# ========================================

chip HeadphoneJack5(
    sleeve,
    ring,
    aux3,
    aux4,
    tip
) {
    model = unavailable;
}


# ========================================
# POWER SUPPLIES
# ========================================

Vpos(5V) between(vcc, 0);
Vneg(-5V) between(vee, 0);


# ========================================
# MAIN CIRCUIT
# ========================================

main {

    # Daisy Seed3
    # Pin 18: Left output
    # Pin 19: Right output, unused
    # Pin 20: Analog ground
    # Pin 40: Digital ground
    # All other pins unused for this demo

    DaisySeed3(
        nc01, nc02, nc03, nc04, nc05,
        nc06, nc07, nc08, nc09, nc10,
        nc11, nc12, nc13, nc14, nc15,
        nc16, nc17,
        audio_left, nc19, 0,
        nc21,
        nc22, nc23, nc24, nc25, nc26,
        nc27, nc28, nc29, nc30, nc31,
        nc32, nc33, nc34, nc35, nc36,
        nc37, nc38, nc39, 0
    );

    # Three parallel input coupling capacitors
    C1(560nF) between(audio_left, coupled);
    C2(560nF) between(audio_left, coupled);
    C3(560nF) between(audio_left, coupled);

    # Input resistor
    Rin(10k) between(coupled, inverting);

    # Negative feedback resistor
    Rfeedback(10k) between(amp_out, inverting);

    # LT1677, physical pins 1 through 8
    LT1677(
        trim1,
        inverting,
        0,
        vee,
        nc5,
        amp_out,
        vcc,
        trim8
    );

    # Power supply decoupling
    Cpositive(100nF) between(vcc, 0);
    Cnegative(100nF) between(vee, 0);

    # Output protection
    Routput(100) between(amp_out, headphone_tip);

    # Five-pin stereo headphone jack
    HeadphoneJack5(
        0,
        ring_unused,
        aux3_unused,
        aux4_unused,
        headphone_tip
    );

    # Voltage measurements
    measure = V audio_left 0;
    measure = V amp_out 0;
    measure = V headphone_tip 0;
}


