
# Daisy Seed3 Stereo LT1677 Audio Output
# Two identical inverting amplifier channels
# Nominal gain = -1
#
# Daisy physical pin 18 = Audio Out 1 (Left)
# Daisy physical pin 19 = Audio Out 2 (Right)
# Daisy physical pin 20 = AGND
#
# TRS headphone jack:
# Tip    = Left
# Ring   = Right
# Sleeve = Ground
#
# Test loads are 10k, NOT actual headphones.

include("LT1677");

f = 1k;

# Bipolar op-amp power supply
Vpos(5V) between(vcc, 0);
Vneg(-5V) between(vee, 0);

# Simulated Daisy audio signals
Vleft(0.1 Vrms) between(audio_left, 0);
Vright(0.1 Vrms) between(audio_right, 0);


# =========================================
# REUSABLE AUDIO CHANNEL
# =========================================

circuit AudioChannel(input, amp_out, jack_out,
                     positive, negative, ground) {

    # Three capacitors in parallel
    # Total capacitance = 1.68uF

    C1(560nF) between(input, coupled);
    C2(560nF) between(input, coupled);
    C3(560nF) between(input, coupled);

    # Input resistance
    Rin(10k) between(coupled, inverting);

    # Negative feedback, nominal gain -1
    Rfeedback(10k) between(amp_out, inverting);

    # LT1677 physical pin order:
    # 1 = Trim
    # 2 = Inverting input
    # 3 = Non-inverting input
    # 4 = Negative supply
    # 5 = NC
    # 6 = Output
    # 7 = Positive supply
    # 8 = Trim

    LT1677(
        trim1,
        inverting,
        ground,
        negative,
        nc5,
        amp_out,
        positive,
        trim8
    );

    # Output series resistance
    Routput(100) between(amp_out, jack_out);

    # Supply bypass capacitors
    Cpositive(100nF) between(positive, ground);
    Cnegative(100nF) between(negative, ground);
}


# =========================================
# MAIN STEREO CIRCUIT
# =========================================

main {

    # LEFT CHANNEL
    AudioChannel(
        audio_left,
        preamp_left,
        headphone_tip,
        vcc,
        vee,
        0
    );

    # RIGHT CHANNEL
    AudioChannel(
        audio_right,
        preamp_right,
        headphone_ring,
        vcc,
        vee,
        0
    );

    # Light test loads
    # Replace with actual output-stage model later
    RloadLeft(10k) between(headphone_tip, 0);
    RloadRight(10k) between(headphone_ring, 0);

    # Daisy output measurements
    measure = V audio_left 0;
    measure = V audio_right 0;

    # LT1677 output measurements
    measure = V preamp_left 0;
    measure = V preamp_right 0;

    # Headphone jack signal measurements
    measure = V headphone_tip 0;
    measure = V headphone_ring 0;

    # Stereo differential measurement
    measure = V headphone_tip headphone_ring;
}


