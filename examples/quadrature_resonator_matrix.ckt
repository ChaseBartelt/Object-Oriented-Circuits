# QUADRATURE RESONATOR MATRIX
# Four coupled state-variable filters drive an eight-branch differential load.
# The name refers to the 90-degree phase shift between the input sources.
# Run in Auto at 10 kHz. Measurements include DC and AC RMS phasors.
# Compiles to 141 components, including 20 ideal op amps and 3 current probes.
# Reference at OUT_P minus OUT_N: -1.349 mV DC, 1.284 V RMS at +105.2 degrees.
# The port sees the load still connected. Its AC impedance is 1.153 + j0.825 ohm.

f = 10k
Va(2.53 V | 0.70<0 Vpk) between(IN_A, 0);
Vb(2.47 V | 0.55<90 Vpk) between(IN_B, 0);
Vc(2.51 V | 0.40<180 Vpk) between(IN_C, 0);
Vd(2.49 V | 0.25<-90 Vpk) between(IN_D, 0);
Vpilot(0 V | 0.12<-35 Vpk) between(PILOT_P, PILOT_N);
Vref(2.50 V | 0 Vpk) between(REF, 0);

parallel integratorFeedback(a, b) {
    Ctime = 1.6n;
    Rdc = 1M;
}

parallel summerFeedback(a, b) {
    Rgain = 10k;
    Crolloff = 82p;
}

circuit integrator(input, output, ref) {
    Rin(10k) between(input, sum);
    integratorFeedback(output, sum);
    op1(ref, sum, output);
}

circuit inverter(input, output, ref) {
    Rin(10k) between(input, sum);
    Rfb(10k) between(output, sum);
    op1(ref, sum, output);
}

circuit resonator(input, cross, pilot, high, band, low, ref) {
    # The inverted band path gives damping. The low path closes the second
    # feedback loop. The finite DC gain keeps the integrators solvable at DC.
    Rinput(15k) between(input, sum);
    Rcross(100k) between(cross, sum);
    Rpilot(150k) between(pilot, sum);
    Rlow(10k) between(low, sum);
    Rdamp(22k) between(damp, sum);
    summerFeedback(high, sum);
    op1(ref, sum, high);
    integrator(high, band, ref);
    integrator(band, low, ref);
    inverter(band, damp, ref);
}

circuit driver(command, output, ref) {
    # Sense after the coil, before the contact resistance. The capacitor
    # supplies a local feedback path around the coil at high frequency.
    Rout(3.3) between(raw, coil_in);
    Llead(33u) between(coil_in, sensed);
    Rcontact(0.82) between(sensed, output);
    Rfb(100) between(sensed, sense);
    Rref(100k) between(sense, ref);
    Cfast(22n) between(raw, sense);
    op1(command, sense, raw);
}

parallel differentialLoad(a, b) {
    series {
        Rwoofer = 33;
        Lwoofer = 680u;
        measure = Iwoofer;
    }
    series {
        RlowMid = 56;
        LlowMid = 330u;
        ClowMid = 1.2u;
    }
    series {
        Rmid = 68;
        Lmid = 220u;
        Cmid = 1.8u;
        measure = Imid;
    }
    series {
        RupperMid = 82;
        LupperMid = 100u;
        CupperMid = 680n;
    }
    series {
        Rtweeter = 100;
        Ctweeter = 330n;
        measure = Itweeter;
    }
    series {
        Rdamper = 47;
        parallel {
            Cdamp = 220n;
            Rleak = 470;
        }
    }
    series {
        Rseries = 120;
        parallel {
            Rparallel = 330;
            Cparallel = 68n;
            Lparallel = 2.2m;
        }
    }
    Rbleed = 100k;
}

main {
    RpilotReturn(1k) between(PILOT_N, REF);
    CpilotReturn(220n) between(PILOT_N, REF);

    # Each resonator receives the previous resonator's band output.
    resonator(IN_A, BAND_D, PILOT_P, HIGH_A, BAND_A, LOW_A, REF);
    resonator(IN_B, BAND_A, PILOT_P, HIGH_B, BAND_B, LOW_B, REF);
    resonator(IN_C, BAND_B, PILOT_P, HIGH_C, BAND_C, LOW_C, REF);
    resonator(IN_D, BAND_C, PILOT_P, HIGH_D, BAND_D, LOW_D, REF);

    # Crossfade different filter outputs into the two bridge commands.
    Rpa(12k) between(BAND_A, SUM_P);
    Rpb(18k) between(HIGH_B, SUM_P);
    Rpc(27k) between(LOW_C, SUM_P);
    Rpd(33k) between(BAND_D, SUM_P);
    Rna(33k) between(LOW_A, SUM_N);
    Rnb(12k) between(BAND_B, SUM_N);
    Rnc(18k) between(HIGH_C, SUM_N);
    Rnd(27k) between(LOW_D, SUM_N);
    summerFeedback(CMD_P, SUM_P);
    summerFeedback(CMD_N, SUM_N);
    op1(REF, SUM_P, CMD_P);
    op2(REF, SUM_N, CMD_N);

    driver(CMD_P, OUT_P, REF);
    driver(CMD_N, OUT_N, REF);
    differentialLoad(OUT_P, OUT_N);

    # Parasitics from each output to the reference and to chassis.
    RbiasP(47k) between(OUT_P, REF);
    RbiasN(47k) between(OUT_N, REF);
    CchassisP(4.7n) between(OUT_P, 0);
    CchassisN(6.8n) between(OUT_N, 0);
    Ccross(2.2n) between(OUT_P, OUT_N);

    measure = V BAND_A BAND_C;
    measure = V BAND_B BAND_D;
    measure = V CMD_P CMD_N;
    measure = V OUT_P OUT_N;
    measure = I Iwoofer_differentialLoad_1;
    measure = I Imid_differentialLoad_1;
    measure = I Itweeter_differentialLoad_1;
    measure = P Rwoofer_differentialLoad_1;
}
port = OUT_P OUT_N
