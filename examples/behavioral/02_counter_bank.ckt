# Three independent counters generated by one compile-time loop.
# Toggle enable0/1/2. Each enabled counter adds 50 every 500 ms.
# Eight-bit values wrap: 0, 50, 100, 150, 200, 250, 44, ...
chip CountBy50(clk, enable, data) {
    clk, enable = input;
    data[8] = output;
    count[8];

    clock(clk, 1kHz) {
        every(500ms) {
            if (enable) {
                count += 50;
            }
        }
    }
    data = count;
}

main CounterBank {
    clk = input;
    for (int i = 0; i < 3; i++) {
        enable${i} = input;
        data${i}[8] = output;
        CountBy50(clk, enable${i}, data${i});
    }
}
