# Single NE555 audio oscillator. Results: out and timing at 10 us.
include("@chips/timers/NE555.ckt");
VCC(5) between(supply, 0);
VReset(5) between(reset_n, 0);
RA(10k) between(supply, discharge);
RB(10k) between(discharge, timing);
CT(100n) between(timing, 0);
main {
    NE555(0, timing, out, reset_n, control, timing, discharge, supply);
}
