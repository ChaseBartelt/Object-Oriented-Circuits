# Four dual/quad channels and two single-stage output monitors.
# Input is a 500 Hz pulse. Compare mix, smooth, and each buffered output.
include("@chips/analog/LM324.ckt");
include("@chips/analog/TL071.ckt");
include("@chips/analog/TL072.ckt");
include("@chips/analog/LM741.ckt");
include("@chips/analog/NE5532.ckt");
VCC(5) between(supply, 0);
VRef(2.5) between(ref, 0);
V1(pulse(0.2, 1, 0, 10u, 10u, 900u, 2m)) between(dry, 0);
R1(10k) between(ref, sum);
R2(10k) between(dry_buffer, sum);
R3(10k) between(mix, smooth);
C1(47n) between(smooth, 0);
RLoad(10k) between(out_ultralow, 0);
main {
    LM324(dry_buffer, dry_buffer, dry, supply, sum, mix, mix, monitor, monitor, smooth, 0, ref, ref_buffer, ref_buffer);
    TL072(voice_buf, voice_buf, dry_buffer, 0, monitor, tone_buf, tone_buf, supply);
    TL071(offset1, out_fet, tone_buf, 0, offset2, out_fet, supply, nc);
    LM741(trim1, out_classic, voice_buf, 0, trim2, out_classic, supply, nc741);
    NE5532(out_ultralow, out_ultralow, out_fet, 0, out_classic, out_classic_buf, out_classic_buf, supply);
}
