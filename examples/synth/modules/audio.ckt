include("@chips/analog/LM358.ckt");
include("@chips/analog/LM386.ckt");
include("@chips/switches/CD4066.ckt");

chip SynthAudio(vcc, gnd, pitch, bass, lead, accent, mid, tone, envelope, mix, speaker) {
    # Select one pitch source and buffer a half-supply reference.
    not(vcc, gnd, pitch, select_bass);
    CD4066(bass, tone, tone, lead, pitch, gnd, gnd, gnd, gnd, gnd, gnd, gnd, select_bass, vcc);
    RTop(10k) between(vcc, bias);
    RBottom(10k) between(bias, gnd);
    RWave(33k) between(tone, sum);
    RReturn(6.8k) between(sum, mid);
    LM358(mid, mid, bias, gnd, sum, mix, mix, vcc);

    # Accents raise the level briefly, while the limiter resistor isolates the timer.
    RAttack(100k) between(accent, envelope);
    CEnvelope(100n) between(envelope, gnd);
    RAccent(220k) between(envelope, sum);

    # Low-pass filter, AC coupling, then the library's small-signal audio amp.
    RFilter(4.7k) between(mix, filtered);
    CFilter(47n) between(filtered, mid);
    CIn(1u) between(filtered, level);
    RAtten(150k) between(level, amp_in);
    RLevel(1k) between(amp_in, gnd);
    LM386(gain1, gnd, amp_in, gnd, amp_out, vcc, bypass, gain8);
    COut(1u) between(amp_out, speaker);
    RLoad(1k) between(speaker, gnd);
}
