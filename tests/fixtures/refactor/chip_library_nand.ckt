# All four NAND gates, in physical 74HC00 pin order.
# Ground the unused inputs. Leave each unused output on its own net.
include("@chips/logic/74HC00.ckt");

VCC(5) between(supply, 0);
VA(5) between(a, 0);
VB(5) between(b, 0);

main {
    SN74HC00(a, b, y, 0, 0, y2, 0, y3, 0, 0, y4, 0, 0, supply);
}
