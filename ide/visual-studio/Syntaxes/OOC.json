{
  "name": "Object-Oriented Circuits",
  "scopeName": "source.ooc",
  "fileTypes": ["ckt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#interpolation" },
    { "include": "#declarations" },
    { "include": "#control" },
    { "include": "#properties" },
    { "include": "#components" },
    { "include": "#calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.ooc",
      "begin": "#",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.ooc" }
      },
      "end": "$",
      "patterns": [
        {
          "name": "storage.type.annotation.ooc",
          "match": "(?<![A-Za-z0-9_])@(?:param|pin)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ooc",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ooc" }
      },
      "end": "\"|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ooc" }
      }
    },
    "interpolation": {
      "name": "meta.interpolation.ooc",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.ooc" }
      },
      "end": "\\}|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)^\\s*(@Override)\\b",
          "captures": {
            "1": { "name": "storage.type.annotation.ooc" }
          }
        },
        {
          "match": "(?i)\\b(circuit|chip|gate|series|parallel)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[(\\{])",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.ooc" }
          }
        },
        {
          "match": "(?i)\\b(battery|transistor)\\b\\s+([A-Za-z][A-Za-z0-9_]*)(?=\\s*[(\\{]|\\$\\{)",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.component.ooc" }
          }
        },
        {
          "name": "keyword.declaration.main.ooc",
          "match": "(?i)\\bmain(?=\\s*(?:\\(\\s*\\))?\\s*\\{)"
        },
        {
          "name": "storage.type.ooc",
          "match": "(?i)\\b(?:series|parallel)(?=\\s*(?:\\([^()]*\\))?\\s*\\{)"
        },
        {
          "match": "(?i)(\\()\\s*(?:(end)\\s+)?(series|parallel|battery|opamp)\\b(?=\\s*(?:[^()=#\\r\\n]+)?\\))",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "storage.type.ooc" }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "begin": "(?i)\\b(?:(else)\\s+)?(if|for|while)\\s*(\\()(?=[^#\\r\\n]*\\)\\s*[;{])",
          "end": "(\\))|(?=#)|$",
          "beginCaptures": {
            "1": { "name": "keyword.control.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#locals" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "keyword.control.ooc",
          "match": "(?i)\\b(?:else|do)(?=\\s*\\{)"
        },
        {
          "match": "(?i)(?:^|(?<=[;{}]))\\s*(break|continue)(?=\\s*[;}])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        { "include": "#locals" },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(return)(?=\\s+[A-Za-z0-9_])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        }
      ]
    },
    "locals": {
      "begin": "(?i)\\b(let|int|bool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
      "end": "(?=[;}]|#)|$",
      "beginCaptures": {
        "1": { "name": "storage.type.ooc" },
        "2": { "name": "variable.other.ooc" },
        "3": { "name": "keyword.operator.assignment.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)|(?=#)|$",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#expression" }
          ]
        },
        {
          "name": "constant.language.boolean.ooc",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        {
          "name": "constant.numeric.ooc",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "keyword.operator.ooc",
          "match": "\\+\\+|--|&&|\\|\\||==|!=|<=|>=|[+*/%=!-]|[<>]"
        },
        {
          "name": "punctuation.separator.ooc",
          "match": "[;,]"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(?:[A-Za-z_][A-Za-z0-9_]*\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*(input|output)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "name": "storage.modifier.pin-direction.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(model)\\s*=\\s*(rc|rl|unavailable)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "name": "keyword.other.property.ooc" },
            "2": { "name": "constant.language.model.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(type)\\s*=\\s*(npn|pnp)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "name": "keyword.other.property.ooc" },
            "2": { "name": "constant.language.polarity.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{:]))\\s*(wire|ground|measure|model|port|base|collector|emitter|type)(?=\\s*=)",
          "captures": {
            "1": { "name": "keyword.other.property.ooc" }
          }
        }
      ]
    },
    "components": {
      "patterns": [
        {
          "name": "entity.name.function.component.ooc",
          "match": "(?i)\\b[RCLVI][A-Za-z0-9_]*(?=(?:\\$\\{[^}\\r\\n]*\\}[A-Za-z0-9_]*)*\\s*\\([^;#\\r\\n]*\\)\\s+between\\s*\\()"
        },
        {
          "match": "(?:^|(?<=[;{]))\\s*([RCLXVI][A-Za-z0-9_]+)(?=\\s*=\\s*[+\\-−.0-9]|\\s+[A-Za-z0-9_.-]+\\s+[A-Za-z0-9_.-]+\\s+[+\\-−.0-9])",
          "captures": {
            "1": { "name": "entity.name.function.component.ooc" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "keyword.other.placement.ooc",
          "match": "(?i)\\b(?:include|connector|between)(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)\\b(?:not|buf|and|nand|or|nor|xor|xnor|op[0-9]+|trans[A-Za-z0-9_]+|switch[A-Za-z0-9_]+|pulse)(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)(?:\\b|(?<=[0-9]))cos(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)\\b[iv](?=\\s*\\(\\s*t\\s*\\)\\s*=)"
        }
      ]
    },
    "numbers": {
      "match": "(?<![A-Za-z0-9_.])([+−-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[ij]?)(?:[ \\t]*([pnuµμmkMG]?(?:V(?:rms|pk|pp)?|A(?:rms|pk|pp)?|ohms?|Ω|F|H|Hz|s|W|J|C|VA|var|Nm|rad/s|deg|°)|[pnuµμmkMG]|%))?(?=cos\\s*\\(|[^A-Za-z0-9_.]|$)",
      "captures": {
        "1": { "name": "constant.numeric.ooc" },
        "2": { "name": "constant.other.unit.ooc" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ooc",
          "match": "==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+*/%\\-]=|[=!?&|^<>∠]"
        }
      ]
    },
    "punctuation": {
      "name": "punctuation.separator.ooc",
      "match": "[{}(),;:]"
    }
  }
}
