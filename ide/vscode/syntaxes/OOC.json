{
  "name": "Object-Oriented Circuits",
  "scopeName": "source.ooc",
  "fileTypes": ["ckt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#arm-rom" },
    { "include": "#strings" },
    { "include": "#interpolation" },
    { "include": "#model-properties" },
    { "include": "#port-groups" },
    { "include": "#declarations" },
    { "include": "#control" },
    { "include": "#properties" },
    { "include": "#components" },
    { "include": "#wire-count-arguments" },
    { "include": "#calls" },
    { "include": "#selectors" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#property-names" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "port-groups": {
      "patterns": [{ "include": "#input-ports" }, { "include": "#output-ports" }, { "include": "#wire-ports" }]
    },
    "port-group-body": {
      "begin": "\\{", "end": "\\}",
      "patterns": [{ "include": "#port-group-content" }]
    },
    "port-group-content": {
      "patterns": [
        { "include": "#comments" }, { "include": "#strings" },
        { "include": "#interpolation" }, { "include": "#control" },
        { "include": "#port-group-body" }, { "include": "#selectors" },
        { "include": "#numbers" },
        { "include": "#port-member-name" },
        { "include": "#punctuation" }
      ]
    },
    "port-member-name": {"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": {"1": {"name": "variable.other.readwrite.port.ooc", "patterns": [{"include": "#identifiers"}]}}},
    "port-declaration-members": {
      "patterns": [{ "include": "#interpolation" }, { "include": "#selectors" },
                    { "include": "#port-member-name" },
                   { "include": "#punctuation" }]
    },
    "input-ports": {
      "name": "meta.declaration.input.ooc", "begin": "(?i)\\b(input)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pin-direction.ooc" },
        "2": { "name": "entity.name.section.ooc entity.name.section.port-group.ooc" },
        "3": { "name": "punctuation.section.block.begin.ooc" }
      },
      "end": "\\}", "endCaptures": { "0": { "name": "punctuation.section.block.end.ooc" } },
      "patterns": [{ "include": "#port-group-content" }]
    },
    "output-ports": {
      "name": "meta.declaration.output.ooc", "begin": "(?i)\\b(output)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pin-direction.ooc" },
        "2": { "name": "entity.name.section.ooc entity.name.section.port-group.ooc" },
        "3": { "name": "punctuation.section.block.begin.ooc" }
      },
      "end": "\\}", "endCaptures": { "0": { "name": "punctuation.section.block.end.ooc" } },
      "patterns": [{ "include": "#port-group-content" }]
    },
    "wire-ports": {
      "name": "meta.declaration.wire.ooc", "begin": "(?i)\\b(wire)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pin-direction.ooc" },
        "2": { "name": "entity.name.section.ooc entity.name.section.port-group.ooc" },
        "3": { "name": "punctuation.section.block.begin.ooc" }
      },
      "end": "\\}", "endCaptures": { "0": { "name": "punctuation.section.block.end.ooc" } },
      "patterns": [{ "include": "#port-group-content" }]
    },
    "arm-rom": {
      "name": "meta.embedded.block.arm.ooc",
      "begin": "(?i)\\b(arm)\\s*\\(\\s*[A-Za-z_]\\w*\\s*,\\s*[A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)?\\s*\\)\\s*\\{",
      "beginCaptures": {
        "1": { "name": "storage.type.ooc" }
      },
      "end": "\\}",
      "patterns": [
        { "name": "comment.line.double-slash.ooc", "match": "//.*$" },
        { "name": "comment.line.at-sign.arm.ooc", "match": "@.*$" },
        { "name": "comment.block.ooc", "begin": "/\\*", "end": "\\*/" },
        {
          "name": "meta.group.registers.arm.ooc",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#arm-register" }]
        },
        { "name": "entity.name.label.ooc", "match": "[A-Za-z_.]\\w*\\s*(?=:)" },
        { "name": "keyword.control.directive.arm.ooc", "match": "(?i)\\.(?:byte|hword|short|word|align|balign|org)\\b" },
        {
          "name": "keyword.operator.instruction.arm.ooc",
          "match": "(?i)(?:^|(?<=[;:]))[ \\t]*([a-z][a-z0-9]*(?:\\.[a-z0-9]+)?)(?=[ \\t;}]|$)"
        },
        { "include": "#arm-register" },
        {
          "name": "constant.numeric.arm.ooc",
          "match": "(?:#\\s*)?[+-]?\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*)\\b"
        },
        { "name": "entity.name.label.reference.arm.ooc", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "arm-register": {
      "name": "variable.language.register.arm.ooc",
      "match": "(?i)\\b(?:r(?:1[0-5]|[0-9])|s(?:[12][0-9]|3[01]|[0-9])|sp|lr|pc|fpscr)\\b"
    },
    "wire-count-arguments": {
      "begin": "(?i)(?:\\b(between)\\s*|(?:^|(?<=[;{}]))\\s*([A-Za-z][A-Za-z0-9_]*)\\s*(?=\\((?:[^();{}#\\r\\n]|\\([^()#\\r\\n]*\\)|[$*]\\{[^{}]*\\})*\\)\\s*(?:;|$)))(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.placement.ooc" },
        "2": {
          "patterns": [
            {
              "name": "keyword.other.placement.ooc",
              "match": "(?i)\\b(?:include|connector|between)\\b"
            },
            {
              "name": "support.function.ooc",
              "match": "(?i)\\b(?:not|buf|and|nand|or|nor|xor|xnor|op[0-9]+|oocCollectorComparator|trans[A-Za-z0-9_]+|switch[A-Za-z0-9_]+|pulse)\\b"
            },
            {
              "name": "support.function.ooc",
              "match": "\\b(?:sevenseg|integrate|delay|transition|square|abs|sqrt|sin|cos|tan|exp|log|log10|floor|ceil|pow|min|max|clamp|ifelse|V|I)\\b"
            },
            {
              "name": "entity.name.function.ooc",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        "3": { "name": "punctuation.section.group.begin.ooc" }
      },
      "end": "\\)|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.group.end.ooc" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#wire-count-reference" },
        { "include": "#wire-count-group" },
        { "include": "#strings" },
        { "include": "#interpolation" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#selectors" },
        { "include": "#property-names" },
        { "include": "#calls" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "wire-count-group": {
      "begin": "\\(",
      "end": "\\)|(?=#)|$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#wire-count-reference" },
        { "include": "#wire-count-group" },
        { "include": "#strings" },
        { "include": "#interpolation" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#selectors" },
        { "include": "#property-names" },
        { "include": "#calls" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "wire-count-reference": {
      "match": "(?<=[(,])\\s*([A-Za-z_][A-Za-z0-9_.-]*)\\s*(?:([$])\\s*([A-Za-z_][A-Za-z0-9_]*)|([*^])\\s*([A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*[,\\)])",
      "captures": {
        "1": { "name": "variable.other.readwrite.ooc" },
        "2": { "name": "keyword.operator.ooc" },
        "3": { "name": "variable.other.readwrite.ooc" },
        "4": { "name": "keyword.operator.ooc" },
        "5": { "name": "variable.other.readwrite.ooc" }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ooc",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.ooc" }
          },
          "end": "$",
          "patterns": [{ "include": "#doc-annotation" }]
        },
        {
          "name": "comment.line.double-slash.ooc",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.ooc" }
          },
          "end": "$",
          "patterns": [{ "include": "#doc-annotation" }]
        },
        {
          "name": "comment.block.ooc",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.ooc" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.ooc" }
          }
        }
      ]
    },
    "doc-annotation": {
      "name": "storage.type.annotation.ooc",
      "match": "(?<![A-Za-z0-9_])@(?:param|pin)\\b"
    },
    "strings": {
      "name": "string.quoted.double.ooc",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ooc" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ooc" }
      },
      "patterns": [
        { "name": "constant.character.escape.ooc", "match": "\\\\." }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.ooc",
      "begin": "[$*]\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.ooc" }
      },
      "end": "\\}|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "model-properties": {
      "begin": "(?i)\\b(properties)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "storage.type.model-properties.ooc" },
        "2": { "name": "punctuation.section.block.begin.ooc" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.ooc" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "variable.other.property.ooc",
          "match": "[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*(?=\\s*=)"
        },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)(?:^|(?<=[;{}]))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(count)\\b(?=\\s*(?:[;}]|$))",
          "captures": {
            "1": { "name": "variable.other.readwrite.ooc" },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.type.ooc" }
          }
        },
        {
          "match": "(?i)\\b(property)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)(?:\\s*(:)\\s*([A-Za-zµμΩ°]+(?:/[A-Za-zµμ]+)?))?(?=\\s*=)",
          "captures": {
            "1": { "name": "storage.type.model-property.ooc" },
            "2": { "name": "variable.other.property.ooc" },
            "3": { "name": "punctuation.separator.ooc" },
            "4": { "name": "storage.type.ooc" }
          }
        },
        {
          "match": "(?i)\\b(analog)\\b(?:\\s*(:)\\s*(math)\\b)?\\s+(\\([^()]*\\)|[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "support.type.analog.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" },
            "4": {
              "patterns": [
                { "include": "#comments" },
                {
                  "name": "support.function.ooc",
                  "match": "(?i)\\b(?:op[0-9]+|oocCollectorComparator)\\b"
                },
                {
                  "name": "entity.name.function.ooc",
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                { "include": "#punctuation" }
              ]
            }
          }
        },
        {
          "match": "(?i)\\b(analog)\\b(?:\\s*(:)\\s*(math)\\b)?(?=\\s*(?:\\{|\\(|[A-Za-z_]))",
          "captures": {
            "1": { "name": "support.type.analog.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" }
          }
        },
        {
          "match": "(?i)\\b(digital)\\b(?:\\s*(:)\\s*(math)\\b)?(?=\\s*(?:\\{|\\(|[A-Za-z_]))",
          "captures": {
            "1": { "name": "keyword.control.digital.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.ooc" },
            "2": { "name": "constant.other.ooc" }
          }
        },
        {
          "match": "(?i)^\\s*(@Override)\\b",
          "captures": {
            "1": { "name": "storage.type.annotation.ooc" }
          }
        },
        {
          "match": "(?i)\\b(circuit|chip|gate|series|parallel)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[(\\{])",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.ooc" }
          }
        },
        {
          "match": "(?i)\\b(battery|transistor|opamp)\\b\\s+([A-Za-z][A-Za-z0-9_]*)(?=\\s*[(\\{;]|[$*]\\{)",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.component.ooc" }
          }
        },
        {
          "match": "(?i)\\b(main)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?(?=\\s*(?:\\(\\s*\\))?\\s*\\{)",
          "captures": {
            "1": { "name": "keyword.declaration.main.ooc" },
            "2": { "name": "entity.name.function.ooc" }
          }
        },
        {
          "name": "storage.type.ooc",
          "match": "(?i)\\b(?:series|parallel)(?=\\s*(?:\\([^()]*\\))?\\s*\\{)"
        },
        {
          "match": "(?i)(\\()\\s*(?:(end)\\s+)?(series|parallel|battery|opamp)\\b(?=\\s*(?:[^()=#\\r\\n]+)?\\))",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "storage.type.ooc" }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        { "name": "keyword.control.clear.ooc", "match": "(?i)\\bclear(?=\\s*\\{)" },
        {
          "name": "storage.type.ooc",
          "match": "\\bconst\\b"
        },
        {
          "begin": "(?i)\\b(?:(else)\\s+)?(if|for|while|clock|every|switch)\\s*(\\()(?=[^#\\r\\n]*\\)\\s*[;{])",
          "end": "(\\))|(?=#)|$",
          "beginCaptures": {
            "1": { "name": "keyword.control.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#locals" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "keyword.control.ooc",
          "match": "(?i)\\b(?:else|do)(?=\\s*\\{)"
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(break|continue)(?=\\s*[;}])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(case)(?=\\s+[^;#{}\\r\\n]+:)",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(default)(?=\\s*:)",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        { "include": "#locals" },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(return)(?=\\s+[A-Za-z0-9_])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        }
      ]
    },
    "locals": {
      "begin": "(?i)\\b(let|int|bool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
      "end": "(?=[;}]|#)|$",
      "beginCaptures": {
        "1": { "name": "storage.type.ooc" },
        "2": { "name": "variable.other.ooc" },
        "3": { "name": "keyword.operator.assignment.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "begin": "\\(",
          "end": "\\)|(?=#)|$",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#expression" }
          ]
        },
        {
          "name": "constant.language.boolean.ooc",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        { "include": "#selectors" },
        { "include": "#numbers" },
        { "include": "#digital-functions" },
        { "include": "#property-names" },
        { "include": "#constants" },
        { "include": "#identifiers" },
        { "include": "#operators" },
        {
          "name": "punctuation.separator.ooc",
          "match": "[;,:\\[\\]]"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "meta.declaration.wire.ooc",
          "match": "(?i)(?:^|(?<=[;{]))\\s*((?:[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?)\\s*(=)\\s*(wire)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "patterns": [{ "include": "#port-declaration-members" }] },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.modifier.pin-direction.ooc" }
          }
        },
        {
          "name": "meta.declaration.input.ooc",
          "match": "(?i)(?:^|(?<=[;{]))\\s*((?:[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?)\\s*(=)\\s*(input)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "patterns": [{ "include": "#port-declaration-members" }] },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.modifier.pin-direction.ooc" }
          }
        },
        {
          "name": "meta.declaration.output.ooc",
          "match": "(?i)(?:^|(?<=[;{]))\\s*((?:[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:[$*]\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?)\\s*(=)\\s*(output)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "patterns": [{ "include": "#port-declaration-members" }] },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.modifier.pin-direction.ooc" }
          }
        },
        {
