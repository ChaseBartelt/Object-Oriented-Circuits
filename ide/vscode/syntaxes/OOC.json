{
  "name": "Object-Oriented Circuits",
  "scopeName": "source.ooc",
  "fileTypes": ["ckt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#interpolation" },
    { "include": "#model-properties" },
    { "include": "#declarations" },
    { "include": "#control" },
    { "include": "#properties" },
    { "include": "#components" },
    { "include": "#wire-count-arguments" },
    { "include": "#calls" },
    { "include": "#selectors" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#property-names" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "wire-count-arguments": {
      "begin": "(?i)(?:\\b(between)\\s*|(?:^|(?<=[;{}]))\\s*([A-Za-z][A-Za-z0-9_]*)\\s*(?=\\((?:[^();{}#\\r\\n]|\\([^()#\\r\\n]*\\)|\\$\\{[^{}]*\\})*\\)\\s*(?:;|$)))(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.placement.ooc" },
        "2": {
          "patterns": [
            {
              "name": "keyword.other.placement.ooc",
              "match": "(?i)\\b(?:include|connector|between)\\b"
            },
            {
              "name": "support.function.ooc",
              "match": "(?i)\\b(?:not|buf|and|nand|or|nor|xor|xnor|op[0-9]+|trans[A-Za-z0-9_]+|switch[A-Za-z0-9_]+|pulse)\\b"
            },
            {
              "name": "support.function.ooc",
              "match": "\\b(?:sevenseg|integrate|delay|transition|square|abs|sqrt|sin|cos|tan|exp|log|log10|floor|ceil|pow|min|max|clamp|ifelse|V|I)\\b"
            },
            {
              "name": "entity.name.function.ooc",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        "3": { "name": "punctuation.section.group.begin.ooc" }
      },
      "end": "\\)|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.group.end.ooc" }
      },
      "patterns": [
        { "include": "#wire-count-reference" },
        { "include": "#wire-count-group" },
        { "include": "#strings" },
        { "include": "#interpolation" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#selectors" },
        { "include": "#property-names" },
        { "include": "#calls" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "wire-count-group": {
      "begin": "\\(",
      "end": "\\)|(?=#)|$",
      "patterns": [
        { "include": "#wire-count-reference" },
        { "include": "#wire-count-group" },
        { "include": "#strings" },
        { "include": "#interpolation" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#selectors" },
        { "include": "#property-names" },
        { "include": "#calls" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "wire-count-reference": {
      "match": "(?<=[(,])\\s*([A-Za-z_][A-Za-z0-9_.-]*)\\s*(?:([$])\\s*([A-Za-z_][A-Za-z0-9_]*)|([*^])\\s*([A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*[,\\)])",
      "captures": {
        "1": { "name": "variable.other.readwrite.ooc" },
        "2": { "name": "keyword.operator.ooc" },
        "3": { "name": "variable.other.readwrite.ooc" },
        "4": { "name": "keyword.operator.ooc" },
        "5": { "name": "variable.other.readwrite.ooc" }
      }
    },
    "comments": {
      "name": "comment.line.number-sign.ooc",
      "begin": "#",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.ooc" }
      },
      "end": "$",
      "patterns": [
        {
          "name": "storage.type.annotation.ooc",
          "match": "(?<![A-Za-z0-9_])@(?:param|pin)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ooc",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ooc" }
      },
      "end": "\"|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ooc" }
      }
    },
    "interpolation": {
      "name": "meta.interpolation.ooc",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.ooc" }
      },
      "end": "\\}|(?=#)|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "model-properties": {
      "begin": "(?i)\\b(properties)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "storage.type.model-properties.ooc" },
        "2": { "name": "punctuation.section.block.begin.ooc" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.ooc" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "variable.other.property.ooc",
          "match": "[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*(?=\\s*=)"
        },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)(?:^|(?<=[;{}]))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(count)\\b(?=\\s*(?:[;}]|$))",
          "captures": {
            "1": { "name": "variable.other.readwrite.ooc" },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.type.ooc" }
          }
        },
        {
          "match": "(?i)\\b(property)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)(?:\\s*(:)\\s*([A-Za-zµμΩ°]+(?:/[A-Za-zµμ]+)?))?(?=\\s*=)",
          "captures": {
            "1": { "name": "storage.type.model-property.ooc" },
            "2": { "name": "variable.other.property.ooc" },
            "3": { "name": "punctuation.separator.ooc" },
            "4": { "name": "storage.type.ooc" }
          }
        },
        {
          "match": "(?i)\\b(analog)\\b(?:\\s*(:)\\s*(math)\\b)?\\s+(\\([^()]*\\)|[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "support.type.analog.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" },
            "4": {
              "patterns": [
                {
                  "name": "entity.name.function.component.ooc",
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                { "include": "#punctuation" }
              ]
            }
          }
        },
        {
          "match": "(?i)\\b(analog)\\b(?:\\s*(:)\\s*(math)\\b)?(?=\\s*(?:\\{|\\(|[A-Za-z_]))",
          "captures": {
            "1": { "name": "support.type.analog.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" }
          }
        },
        {
          "match": "(?i)\\b(digital)\\b(?:\\s*(:)\\s*(math)\\b)?(?=\\s*(?:\\{|\\(|[A-Za-z_]))",
          "captures": {
            "1": { "name": "keyword.control.digital.ooc" },
            "2": { "name": "punctuation.separator.ooc" },
            "3": { "name": "keyword.other.property.ooc" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.ooc" },
            "2": { "name": "constant.other.ooc" }
          }
        },
        {
          "match": "(?i)^\\s*(@Override)\\b",
          "captures": {
            "1": { "name": "storage.type.annotation.ooc" }
          }
        },
        {
          "match": "(?i)\\b(circuit|chip|gate|series|parallel)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[(\\{])",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.ooc" }
          }
        },
        {
          "match": "(?i)\\b(battery|transistor|opamp)\\b\\s+([A-Za-z][A-Za-z0-9_]*)(?=\\s*[(\\{;]|\\$\\{)",
          "captures": {
            "1": { "name": "storage.type.ooc" },
            "2": { "name": "entity.name.function.component.ooc" }
          }
        },
        {
          "match": "(?i)\\b(main)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?(?=\\s*(?:\\(\\s*\\))?\\s*\\{)",
          "captures": {
            "1": { "name": "keyword.declaration.main.ooc" },
            "2": { "name": "entity.name.function.ooc" }
          }
        },
        {
          "name": "storage.type.ooc",
          "match": "(?i)\\b(?:series|parallel)(?=\\s*(?:\\([^()]*\\))?\\s*\\{)"
        },
        {
          "match": "(?i)(\\()\\s*(?:(end)\\s+)?(series|parallel|battery|opamp)\\b(?=\\s*(?:[^()=#\\r\\n]+)?\\))",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "storage.type.ooc" }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "storage.type.ooc",
          "match": "\\bconst\\b"
        },
        {
          "begin": "(?i)\\b(?:(else)\\s+)?(if|for|while|clock|every|switch)\\s*(\\()(?=[^#\\r\\n]*\\)\\s*[;{])",
          "end": "(\\))|(?=#)|$",
          "beginCaptures": {
            "1": { "name": "keyword.control.ooc" },
            "2": { "name": "keyword.control.ooc" },
            "3": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#locals" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "keyword.control.ooc",
          "match": "(?i)\\b(?:else|do)(?=\\s*\\{)"
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(break|continue)(?=\\s*[;}])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(case)(?=\\s+[^;#{}\\r\\n]+:)",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{}:]))\\s*(default)(?=\\s*:)",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        },
        { "include": "#locals" },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(return)(?=\\s+[A-Za-z0-9_])",
          "captures": {
            "1": { "name": "keyword.control.ooc" }
          }
        }
      ]
    },
    "locals": {
      "begin": "(?i)\\b(let|int|bool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
      "end": "(?=[;}]|#)|$",
      "beginCaptures": {
        "1": { "name": "storage.type.ooc" },
        "2": { "name": "variable.other.ooc" },
        "3": { "name": "keyword.operator.assignment.ooc" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#strings" },
        {
          "begin": "\\(",
          "end": "\\)|(?=#)|$",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.ooc" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.ooc" }
          },
          "patterns": [
            { "include": "#expression" }
          ]
        },
        {
          "name": "constant.language.boolean.ooc",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        { "include": "#selectors" },
        { "include": "#numbers" },
        { "include": "#digital-functions" },
        { "include": "#property-names" },
        { "include": "#constants" },
        { "include": "#identifiers" },
        {
          "name": "keyword.operator.ooc",
          "match": "<<=?|>>=?|\\+\\+|--|&&|\\|\\||==|!=|<=|>=|[+*/%&|^\\-]=|[+*/%=!?&|^<>-]"
        },
        {
          "name": "punctuation.separator.ooc",
          "match": "[;,:\\[\\]]"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*((?:[A-Za-z_][A-Za-z0-9_]*(?:\\$\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\$\\{[^}#\\r\\n]+\\}[A-Za-z0-9_]*)*(?:\\s*\\[\\s*[0-9_]+(?:\\s*:\\s*[0-9_]+)?\\s*\\])?)\\s*(=)\\s*(input|output|wire)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": {
              "patterns": [
                { "include": "#interpolation" },
                { "include": "#selectors" },
                { "include": "#identifiers" },
                { "include": "#punctuation" }
              ]
            },
            "2": { "name": "keyword.operator.assignment.ooc" },
            "3": { "name": "storage.modifier.pin-direction.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(model)\\s*=\\s*(rc|rl|unavailable)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "name": "keyword.other.property.ooc" },
            "2": { "name": "constant.language.model.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(type)\\s*=\\s*(npn|pnp)(?=\\s*(?:[;}#]|$))",
          "captures": {
            "1": { "name": "keyword.other.property.ooc" },
            "2": { "name": "constant.language.polarity.ooc" }
          }
        },
        {
          "match": "(?i)(?:^|(?<=[;{:]))\\s*(wire|ground|measure|model|port|base|collector|emitter|type|Vneg|gain(?:[._](?:default|max|resistor))?|bandwidth|gbw|slew|offset|delay[._](?:rise|fall)|response[._]time|supply[._]current(?:[._]total)?|output[._](?:min|max|bias|type|low[._]at4mA)|bypass[._]resistance|common[._](?:min|max|rejection|impedance))(?=\\s*=)",
          "captures": {
            "1": { "name": "variable.other.property.ooc" }
          }
        }
      ]
    },
    "components": {
      "patterns": [
        {
          "name": "entity.name.function.component.ooc",
          "match": "(?i)\\b[RCLZVIPS][A-Za-z0-9_]*(?=(?:\\$\\{[^}\\r\\n]*\\}[A-Za-z0-9_]*)*(?:\\s*\\([^;#\\r\\n]*\\)\\s+|\\s+)between\\s*\\()"
        },
        {
          "match": "(?i)(?:^|(?<=[;{]))\\s*(S[A-Za-z0-9_]*)(?=\\s*=\\s*(?:open|closed|on|off|[01])\\b)",
          "captures": {
            "1": { "name": "entity.name.function.component.ooc" }
          }
        },
        {
          "name": "constant.language.switch-state.ooc",
          "match": "(?i)\\b(?:open|closed|on|off)\\b"
        },
        {
          "match": "(?:^|(?<=[;{]))\\s*([RCLXZVI][A-Za-z0-9_]+)(?=\\s*=\\s*[+\\-−.0-9]|\\s+[A-Za-z0-9_.-]+\\s+[A-Za-z0-9_.-]+\\s+[+\\-−.0-9])",
          "captures": {
            "1": { "name": "entity.name.function.component.ooc" }
          }
        }
      ]
    },
    "digital-functions": {
      "name": "support.function.ooc",
      "match": "\\b(?:sevenseg|integrate|delay|transition|square|abs|sqrt|sin|cos|tan|exp|log|log10|floor|ceil|pow|min|max|clamp|ifelse)(?=\\s*\\()"
    },
    "calls": {
      "patterns": [
        { "include": "#digital-functions" },
        {
          "name": "keyword.other.placement.ooc",
          "match": "(?i)\\b(?:include|connector|between)(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)\\b(?:not|buf|and|nand|or|nor|xor|xnor|op[0-9]+|trans[A-Za-z0-9_]+|switch[A-Za-z0-9_]+|pulse)(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)(?:\\b|(?<=[0-9]))cos(?=\\s*\\()"
        },
        {
          "name": "support.function.ooc",
          "match": "(?i)\\b[iv](?=\\s*\\(\\s*t\\s*\\)\\s*=)"
        },
        {
          "name": "support.function.ooc",
          "match": "\\b[VI](?=\\s*\\()"
        },
        {
          "name": "entity.name.function.ooc",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "selectors": {
      "name": "meta.brackets.ooc",
      "begin": "\\[",
      "end": "\\]|(?=#)|$",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.ooc" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.ooc" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#expression" }
      ]
    },
    "identifiers": {
      "name": "variable.other.readwrite.ooc",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "numbers": {
      "match": "(?<![A-Za-z0-9_.])([+−-]?(?:[0-9]+(?:_[0-9]+)*(?:\\.[0-9]*(?:_[0-9]+)*)?|\\.[0-9]+(?:_[0-9]+)*)(?:[eE][+-]?[0-9]+)?[ij]?)(?:[ \\t]*([pnuµμmkMG]?(?:V/(?:[munµμ]?s)|V(?:rms|pk|pp)?|A(?:rms|pk|pp)?|ohms?|Ω|F|H|Hz|s|W|J|C|VA|var|Nm|rad/s|deg|dB|°)|[pnuµμmkMG]|%))?(?=cos\\s*\\(|[^A-Za-z0-9_.]|$)",
      "captures": {
        "1": { "name": "constant.numeric.ooc" },
        "2": { "name": "constant.other.unit.ooc" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ooc",
          "match": "<<=?|>>=?|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+*/%&|^\\-]=|[=!?&|^<>∠+*/%\\-]"
        }
      ]
    },
    "punctuation": {
      "name": "punctuation.separator.ooc",
      "match": "[{}(),;:\\[\\]]"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ooc",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.output-type.ooc",
          "match": "(?i)\\b(?:open_collector|power_amplifier)\\b"
        },
        {
          "name": "constant.language.polarity.ooc",
          "match": "(?i)\\b(?:npn|pnp)\\b"
        },
        {
          "name": "constant.language.model.ooc",
          "match": "(?i)\\b(?:ideal|unavailable)\\b"
        }
      ]
    },
    "property-names": {
      "name": "variable.other.property.ooc",
      "match": "(?<![A-Za-z0-9_.])[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+(?![A-Za-z0-9_.])"
    }
  }
}
