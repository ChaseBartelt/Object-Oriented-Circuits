{
  "name": "ooc-language",
  "displayName": "Object-Oriented Circuits",
  "description": "Edit, navigate, and check Object-Oriented Circuits (.ckt) files.",
  "version": "0.8.15",
  "publisher": "echoingfarts",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and navigation work in Restricted Mode. Circuit commands run the local OOC compiler in a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Circuit commands operate on saved local files."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "[ooc]": { "editor.tabSize": 4, "editor.insertSpaces": true },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          { "scope": "entity.name.section.port-group.ooc", "settings": { "foreground": "#d4d4d4" } },
          { "scope": "string.quoted.double.ooc", "settings": { "foreground": "#aed6ff" } },
          {
            "scope": [
              "meta.declaration.input.ooc storage.modifier.pin-direction.ooc"
            ],
            "settings": {
              "foreground": "#f6a652"
            }
          },
          {
            "scope": [
              "meta.declaration.output.ooc storage.modifier.pin-direction.ooc"
            ],
            "settings": {
              "foreground": "#659cd7"
            }
          },
          {
            "scope": [
              "meta.declaration.wire.ooc storage.modifier.pin-direction.ooc"
            ],
            "settings": {
              "foreground": "#4ec9b0"
            }
          },
          {
            "scope": [
              "keyword.operator.instruction.arm.ooc",
              "keyword.control.directive.arm.ooc"
            ],
            "settings": {
              "foreground": "#b45a5a"
            }
          },
          {
            "scope": "variable.language.register.arm.ooc",
            "settings": {
              "foreground": "#9cdcfe"
            }
          },
          {
            "scope": [
              "meta.embedded.block.arm.ooc entity.name.label.ooc",
              "entity.name.label.reference.arm.ooc"
            ],
            "settings": {
              "foreground": "#b5cea8"
            }
          },
          {
            "scope": "constant.numeric.arm.ooc",
            "settings": {
              "foreground": "#ce9178"
            }
          },
          {
            "scope": "meta.embedded.block.arm.ooc comment",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "keyword.control.clear.ooc",
            "settings": {
              "foreground": "#659cd7"
            }
          },
          {
            "scope": "keyword.operator.comparison.ooc",
            "settings": {
              "foreground": "#82aaff"
            }
          },
          {
            "scope": "keyword.operator.logical.ooc",
            "settings": {
              "foreground": "#c792ea"
            }
          },
          {
            "scope": "keyword.operator.bitwise.ooc",
            "settings": {
              "foreground": "#4ec9b0"
            }
          },
          {
            "scope": "keyword.operator.shift.ooc",
            "settings": {
              "foreground": "#ffb86c"
            }
          },
          {
            "scope": "keyword.operator.ternary.ooc",
            "settings": {
              "foreground": "#dcdcaa"
            }
          },
          {
            "scope": "keyword.operator.arithmetic.ooc",
            "settings": {
              "foreground": "#e6b98b"
            }
          },
          {
            "scope": "keyword.operator.assignment.ooc",
            "settings": {
              "foreground": "#9aa0a6"
            }
          }
        ]
      }
    },
    "languages": [
      {
        "id": "ooc",
        "aliases": ["Object-Oriented Circuits", "OOC"],
        "extensions": [".ckt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ooc",
        "scopeName": "source.ooc",
        "path": "./syntaxes/OOC.json"
      }
    ],
    "snippets": [
      { "language": "ooc", "path": "./snippets/ooc.code-snippets" }
    ],
    "commands": [
      { "command": "ooc.checkForUpdates", "category": "OOC", "title": "Check for Updates" },
      { "command": "ooc.check", "category": "OOC", "title": "Check Circuit" },
      { "command": "ooc.solve", "category": "OOC", "title": "Solve Circuit" },
      { "command": "ooc.openSchematic", "category": "OOC", "title": "Run Circuit / Open Schematic", "icon": "$(play)" },
      { "command": "ooc.toggleLineComment", "category": "OOC", "title": "Toggle Line Comment" }
    ],
    "keybindings": [
      {
        "command": "ooc.toggleLineComment",
        "key": "ctrl+shift+3",
        "when": "editorTextFocus && !editorReadonly && editorLangId == ooc"
      },
      {
        "command": "ooc.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == ooc"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "ooc.openSchematic", "when": "resourceLangId == ooc && resourceScheme == file", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Object-Oriented Circuits",
      "properties": {
        "ooc.autoUpdate": {
          "type": "boolean", "default": true, "scope": "window",
          "description": "Check for installed OOC application updates, or apply local extension releases when using a development checkout."
        },
        "ooc.refreshOnSave": {
          "type": "boolean", "default": true,
          "description": "Refresh the running schematic after saving a circuit or included file in its OOC project."
        },
        "ooc.hoverPreviews": {
          "type": "boolean", "default": true,
          "description": "Show gate/chip pin diagrams and highlighted wire previews on hover using the local OOC compiler."
        },
        "ooc.projectRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to the OOC checkout when editing circuits in a separate folder."
        },
        "ooc.installationPath": {
          "type": "string", "default": "", "scope": "machine",
          "description": "Optional custom OOC installer location. The standard per-user installation is detected automatically."
        },
        "ooc.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python executable for the OOC compiler. Defaults to the checkout's .venv when available."
        }
      }
    }
  }
}
