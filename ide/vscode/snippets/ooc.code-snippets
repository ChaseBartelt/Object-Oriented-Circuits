{
  "OOC divider example": {
    "prefix": "ooc-divider",
    "body": [
      "# Voltage divider",
      "(battery supply)",
      "\tV = ${1:5}",
      "\twire = vin",
      "(end battery)",
      "",
      "circuit ${2:divider}(input, output, ground) {",
      "\tR1(${3:10}) between(input, output);",
      "\tR2(${4:30}) between(output, ground);",
      "}",
      "",
      "main {",
      "\t$2(vin, out, 0);",
      "\tmeasure = V out 0;",
      "}",
      "$0"
    ],
    "description": "Insert a complete OOC divider with a battery, circuit method, and main block."
  },
  "Circuit method": {
    "prefix": "circuit",
    "body": [
      "circuit ${1:stage}(${2:input}, ${3:output}, ${4:ground}) {",
      "\tR1(${5:1k}) between($2, $3);",
      "\tR2(${6:1k}) between($3, $4);",
      "\t$0",
      "}"
    ],
    "description": "Define a reusable electrical circuit method."
  },
  "Main block": {
    "prefix": "main",
    "body": [
      "main {",
      "\t$0",
      "}"
    ],
    "description": "Assemble an electrical circuit or declare ports and call behavioral digital chips."
  },
  "Digital assembly": {
    "prefix": "ooc-main",
    "body": [
      "chip ${1:Select}(choose, a, b, y) {",
      "\tchoose = input;",
      "\ta[8], b[8] = input;",
      "\ty[8] = output;",
      "\tif (choose) { y = a; } else { y = b; }",
      "}",
      "",
      "main ${2:Design} {",
      "\tchoose = input;",
      "\ta[8], b[8] = input;",
      "\ty[8] = output;",
      "\t$1(choose, a, b, y);",
      "\t$0",
      "}"
    ],
    "description": "Define a behavioral byte selector and assemble its external connections in main."
  },
  "Resistor placement": {
    "prefix": "resistor",
    "body": "${1:R1}(${2:1k}) between(${3:in}, ${4:out});$0",
    "description": "Place a resistor between two nodes."
  },
  "Manual switch": {
    "prefix": "switch",
    "body": "${1:S1}(${2|open,closed|}) between(${3:in}, ${4:out});$0",
    "description": "Place a two-terminal switch; click its schematic symbol to toggle it."
  },
  "Negative battery supply": {
    "prefix": "battery-negative",
    "body": [
      "battery ${1:NegSupply} {",
      "\tVneg = ${2:5};",
      "\twire = ${3:neg};",
      "}",
      "$0"
    ],
    "description": "Declare a negative rail; Vneg = 5 means -5 volts."
  },
  "Op amp with supply pins": {
    "prefix": "opamp-powered",
    "body": "${1:op1}(${2:in_plus}, ${3:in_minus}, ${4:out}, ${5:vplus}, ${6:vminus});$0",
    "description": "Place an ideal op amp with optional positive and negative supply identifiers."
  },
  "Link circuit file": {
    "prefix": "include",
    "body": "include(\"${1:other.ckt}\");$0",
    "description": "Include an OOC file relative to this file, or use an @chips/ path."
  },
  "Compile-time for loop": {
    "prefix": "for",
    "body": [
      "for (int i = 1; i <= ${1:3}; i++) {",
      "\tR\\${i\\}(${2:1k}) between(n\\${i - 1\\}, n\\${i\\});",
      "\t$0",
      "}"
    ],
    "description": "Generate indexed resistors in an electrical method or main block."
  },
  "Compile-time if and else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:true}) {",
      "\t${2:RLoad(3k) between(out, 0);}",
      "} else {",
      "\t${3:RLoad(1k) between(out, 0);}",
      "}$0"
    ],
    "description": "Choose which circuit statements compile."
  },
  "Digital NAND chip": {
    "prefix": "ooc-chip",
    "body": [
      "chip ${1:NandGate}(a, b, y) {",
      "\ta, b = input;",
      "\ty = output;",
      "\ty = !(a & b);",
      "}$0"
    ],
    "description": "Define a combinational chip for standalone simulation/export or calls from digital main."
  },
  "Digital bus port": {
    "prefix": "ooc-bus",
    "body": "${1:data}[${2:8}] = ${3|input,output|};$0",
    "description": "Declare an unsigned digital input or output bus."
  },
  "Digital internal connection": {
    "prefix": "ooc-wire",
    "body": "${1:link}[${2:8}] = wire;$0",
    "description": "Declare an unsigned internal bus between chip instances or combinational assignments. Remove [width] for a scalar."
  },
  "Clocked behavior": {
    "prefix": "ooc-clock",
    "body": [
      "clock(${1:clk}, ${2:50MHz}) {",
      "\t$0",
      "}"
    ],
    "description": "Inside a digital chip, update declared state at rising clock edges."
  },
  "Periodic clocked behavior": {
    "prefix": "ooc-every",
    "body": [
      "every(${1:500ms}) {",
      "\t${2:state} = !$2;",
      "\t$0",
      "}"
    ],
    "description": "Inside clock(clk, frequency), toggle declared scalar state at a fixed interval."
  },
  "Combinational selection": {
    "prefix": "ooc-if",
    "body": [
      "if (${1:choose}) {",
      "\t${2:y} = ${3:a};",
      "} else {",
      "\t$2 = ${4:b};",
      "}$0"
    ],
    "description": "Inside a digital chip outside clock, drive every selected output or wire on every branch."
  },
  "Generated chip bank": {
    "prefix": "ooc-bank",
    "body": [
      "chip ${1:Follow}(a, y) {",
      "\ta = input;",
      "\ty = output;",
      "\ty = a;",
      "}",
      "",
      "main ${2:Bank} {",
      "\tfor (int i = 0; i < ${3:4}; i++) {",
      "\t\tin\\${i\\} = input;",
      "\t\tout\\${i\\} = output;",
      "\t\t$1(in\\${i\\}, out\\${i\\});",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Generate independently scoped chip instances and connections during compilation of main."
  }
}
