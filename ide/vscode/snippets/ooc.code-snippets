{
  "OOC divider example": {
    "prefix": "ooc-divider",
    "body": [
      "# Voltage divider",
      "(battery supply)",
      "\tV = ${1:5}",
      "\twire = vin",
      "(end battery)",
      "",
      "circuit ${2:divider}(input, output, ground) {",
      "\tR1(${3:10}) between(input, output);",
      "\tR2(${4:30}) between(output, ground);",
      "}",
      "",
      "main {",
      "\t$2(vin, out, 0);",
      "\tmeasure = V out 0;",
      "}",
      "$0"
    ],
    "description": "Insert a complete OOC divider with a battery, circuit method, and main block."
  },
  "Circuit method": {
    "prefix": "circuit",
    "body": [
      "circuit ${1:stage}(${2:input}, ${3:output}, ${4:ground}) {",
      "\tR1(${5:1k}) between($2, $3);",
      "\tR2(${6:1k}) between($3, $4);",
      "\t$0",
      "}"
    ],
    "description": "Define a reusable electrical circuit method."
  },
  "Main block": {
    "prefix": "main",
    "body": [
      "main {",
      "\t$0",
      "}"
    ],
    "description": "Assemble an electrical circuit or declare ports and call behavioral digital chips."
  },
  "Digital assembly": {
    "prefix": "ooc-main",
    "body": [
      "chip ${1:Select}(choose, a, b, y) {",
      "\tchoose = input;",
      "\ta[8], b[8] = input;",
      "\ty[8] = output;",
      "\tif (choose) { y = a; } else { y = b; }",
      "}",
      "",
      "main ${2:Design} {",
      "\tchoose = input;",
      "\ta[8], b[8] = input;",
      "\ty[8] = output;",
      "\t$1(choose, a, b, y);",
      "\t$0",
      "}"
    ],
    "description": "Define a behavioral byte selector and assemble its external connections in main."
  },
  "Resistor placement": {
    "prefix": "resistor",
    "body": "${1:R1}(${2:1k}) between(${3:in}, ${4:out});$0",
    "description": "Place a resistor between two nodes."
  },
  "Manual switch": {
    "prefix": "switch",
    "body": "${1:S1}(${2|open,closed|}) between(${3:in}, ${4:out});$0",
    "description": "Place a two-terminal switch; click its schematic symbol to toggle it."
  },
  "Negative battery supply": {
    "prefix": "battery-negative",
    "body": [
      "battery ${1:NegSupply} {",
      "\tVneg = ${2:5};",
      "\twire = ${3:neg};",
      "}",
      "$0"
    ],
    "description": "Declare a negative rail; Vneg = 5 means -5 volts."
  },
  "Op amp with supply pins": {
    "prefix": "opamp-powered",
    "body": "${1:op1}(${2:in_plus}, ${3:in_minus}, ${4:out}, ${5:vplus}, ${6:vminus});$0",
    "description": "Place an ideal op amp with optional positive and negative supply identifiers."
  },
  "Op amp ideal defaults": {
    "prefix": "opamp-default",
    "body": [
      "opamp ${1:op1};",
      "$1(${2:plus}, ${3:minus}, ${4:out});$0"
    ],
    "description": "Declare an ideal op amp; an optional block can override its defaults."
  },
  "Analog math equation": {
    "prefix": "analog-math",
    "body": "analog V(${1:out}) = V(${2:input}) * ${3:10};$0",
    "description": "Add a voltage equation used by simulation without drawing a source symbol."
  },
  "Digital math block": {
    "prefix": "digital-math",
    "body": [
      "digital {",
      "\t${1:out} = ${2:a} & ${3:b};",
      "}$0"
    ],
    "description": "Add logic behavior without schematic parts; digital chips keep their existing I/O declarations."
  },
  "Analog op amp math": {
    "prefix": "analog-opamp",
    "body": [
      "${1:op1}(${2:plus}, ${3:minus}, ${4:out}, ${5:vplus}, ${6:vminus});",
      "analog $1 {",
      "\tgain = ${7:19e6};",
      "\tbandwidth = ${8:7.2MHz};",
      "\tslew = ${9:2.5V/us};",
      "\toffset = ${10:20uV};",
      "}$0"
    ],
    "description": "Configure the existing op-amp symbol with a separate optional mathematical model."
  },
  "Op amp parameter overrides": {
    "prefix": "opamp-model",
    "body": [
      "opamp ${1:op1} {",
      "\tgain = ${2:19e6};",
      "\tbandwidth = ${3:7.2MHz};",
      "\tslew = ${4:2.5V/us};",
      "\toffset = ${5:20uV};",
      "\tsupply.current = ${6:2.75mA};",
      "}",
      "$1(${7:plus}, ${8:minus}, ${9:out}, ${10:vplus}, ${11:vminus});$0"
    ],
    "description": "Override any op-amp defaults with gain, GBW, slew, offset and quiescent supply current."
  },
  "Link circuit file": {
    "prefix": "include",
    "body": "include(\"${1:other.ckt}\");$0",
    "description": "Include an OOC file relative to this file, or use an @chips/ path."
  },
  "Compile-time for loop": {
    "prefix": "for",
    "body": [
      "for (int i = 1; i <= ${1:3}; i++) {",
      "\tR\\${i\\}(${2:1k}) between(n\\${i - 1\\}, n\\${i\\});",
      "\t$0",
      "}"
    ],
    "description": "Generate indexed resistors in an electrical method or main block."
  },
  "Compile-time if and else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:true}) {",
      "\t${2:RLoad(3k) between(out, 0);}",
      "} else {",
      "\t${3:RLoad(1k) between(out, 0);}",
      "}$0"
    ],
    "description": "Choose which circuit statements compile."
  },
  "Digital NAND chip": {
    "prefix": "ooc-chip",
    "body": [
      "chip ${1:NandGate}(a, b, y) {",
      "\ta, b = input;",
      "\ty = output;",
      "\ty = !(a & b);",
      "}$0"
    ],
    "description": "Define a combinational chip for standalone simulation/export or calls from digital main."
  },
  "Digital bus port": {
    "prefix": "ooc-bus",
    "body": "${1:data}[${2:8}] = ${3|input,output|};$0",
    "description": "Declare an unsigned digital input or output bus."
  },
  "Digital internal connection": {
    "prefix": "ooc-wire",
    "body": "${1:link}[${2:8}] = wire;$0",
    "description": "Declare an unsigned internal bus between chip instances or combinational assignments. Remove [width] for a scalar."
  },
  "Clocked behavior": {
    "prefix": "ooc-clock",
    "body": [
      "clock(${1:clk}, ${2:50MHz}) {",
      "\t$0",
      "}"
    ],
    "description": "Inside a digital chip, update declared state at rising clock edges."
  },
  "Periodic clocked behavior": {
    "prefix": "ooc-every",
    "body": [
      "every(${1:500ms}) {",
      "\t${2:state} = !$2;",
      "\t$0",
      "}"
    ],
    "description": "Inside clock(clk, frequency), toggle declared scalar state at a fixed interval."
  },
  "Combinational selection": {
    "prefix": "ooc-if",
    "body": [
      "if (${1:choose}) {",
      "\t${2:y} = ${3:a};",
      "} else {",
      "\t$2 = ${4:b};",
      "}$0"
    ],
    "description": "Inside a digital chip outside clock, drive every selected output or wire on every branch."
  },
  "Generated chip bank": {
    "prefix": "ooc-bank",
    "body": [
      "chip ${1:Follow}(a, y) {",
      "\ta = input;",
      "\ty = output;",
      "\ty = a;",
      "}",
      "",
      "main ${2:Bank} {",
      "\tfor (int i = 0; i < ${3:4}; i++) {",
      "\t\tin\\${i\\} = input;",
      "\t\tout\\${i\\} = output;",
      "\t\t$1(in\\${i\\}, out\\${i\\});",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Generate independently scoped chip instances and connections during compilation of main."
  },
  "Eight pin audio amplifier": {
    "prefix": "opamp-audio",
    "body": [
      "${1:op1}(${2:plus}, ${3:minus}, ${4:out}, ${5:vplus}, ${6:vminus}, ${7:gain1}, ${8:gain8}, ${9:bypass});",
      "analog $1 {",
      "\tgain.default = ${10:20};",
      "\tgain.max = ${11:200};",
      "\tgain.resistor = ${12:1.35k};",
      "\toutput.bias = ${13:0.5};",
      "\tsupply.current = ${14:4mA};",
      "}$0"
    ],
    "description": "Use an eight-argument op amp for audio, with gain and bypass pins."
  },
  "Shared amplifier settings": {
    "prefix": "analog-group",
    "body": [
      "analog (${1:op1}, ${2:op2}) {",
      "\tgain = ${3:100000};",
      "\tgbw = ${4:1.2MHz};",
      "\tslew = ${5:0.5V/us};",
      "\toffset = ${6:3mV};",
      "}$0"
    ],
    "description": "Apply shared model properties to connected amplifiers."
  },
  "Override imported chip model": {
    "prefix": "override-chip",
    "body": [
      "@override",
      "chip ${1:LM324} {",
      "\tanalog (${2:op1}, ${3:op2}, ${4:op3}, ${5:op4}) {",
      "\t\tgbw = ${6:2MHz};",
      "\t\tslew = ${7:1V/us};",
      "\t}",
      "}$0"
    ],
    "description": "Patch an included chip model while retaining its original pins and electrical connections."
  },
  "Op amp common mode properties": {
    "prefix": "opamp-common",
    "body": [
      "${1:op1}(${2:plus}, ${3:minus}, ${4:out}, ${5:vplus}, ${6:vminus});",
      "analog $1 {",
      "\tcommon.min = vminus + ${7:3V};",
      "\tcommon.max = vplus;",
      "\tcommon.rejection = ${8:100dB};",
      "\tcommon.impedance = ${9:1G};",
      "}$0"
    ],
    "description": "Declare common-mode range, CMRR and finite input impedance."
  },
  "Stateful analog filter": {
    "prefix": "analog-state",
    "body": [
      "analog {",
      "\tproperty tau = ${1:1ms};",
      "\terror = V(${2:input}) - V(${3:out});",
      "\tV($3) = integrate(error / tau, ${4:0V});",
      "}$0"
    ],
    "description": "Define an implicit first-order filter with local properties and integration; adds no schematic symbols."
  },
  "Custom mathematical chip": {
    "prefix": "chip-math",
    "body": [
      "chip ${1:MyAmplifier}(input, out, gnd) {",
      "\tanalog {",
      "\t\tproperties {",
      "\t\t\tgain = ${2:10};",
      "\t\t\toffset = ${3:2mV};",
      "\t\t\toutput.max = ${4:12V};",
      "\t\t}",
      "\t\tV(out, gnd) = min(gain * V(input, gnd) + offset, output.max);",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Define custom model properties with inferred SI units, without schematic components."
  }
}
