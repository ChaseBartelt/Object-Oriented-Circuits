# CD4017 | 16-pin package | pin 1 first.
# 5 V Johnson counter approximation. Initialize with reset. Carry is high during counts 0 through 4.
# Datasheet: https://www.ti.com/lit/ds/symlink/cd4017b.pdf

include("../shared/flipFlop.ckt");

chip CD4017(q5, q1, q0, q2, q6, q7, q3, gnd, q8, q4, q9, carry, clk_inhibit, clk, reset, vdd) {  # External ports retain package order; internal instances share only their explicitly bound nets.
    not(vdd, gnd, reset, reset_n);
    not(vdd, gnd, clk_inhibit, enabled);
    and(vdd, (enabled, clk), count_clock);
    oocDFlipFlop(vdd, gnd, s5_n, count_clock, vdd, reset_n, s1, s1_n);
    oocDFlipFlop(vdd, gnd, s1, count_clock, vdd, reset_n, s2, s2_n);
    oocDFlipFlop(vdd, gnd, s2, count_clock, vdd, reset_n, s3, s3_n);
    oocDFlipFlop(vdd, gnd, s3, count_clock, vdd, reset_n, s4, s4_n);
    oocDFlipFlop(vdd, gnd, s4, count_clock, vdd, reset_n, s5, s5_n);
    and(vdd, gnd, s1_n, s5_n, q0);
    and(vdd, gnd, s1, s2_n, q1);
    and(vdd, gnd, s2, s3_n, q2);
    and(vdd, gnd, s3, s4_n, q3);
    and(vdd, gnd, s4, s5_n, q4);
    and(vdd, gnd, s1, s5, q5);
    and(vdd, gnd, s1_n, s2, q6);
    and(vdd, gnd, s2_n, s3, q7);
    and(vdd, gnd, s3_n, s4, q8);
    and(vdd, gnd, s4_n, s5, q9);
    buf(vdd, gnd, s5_n, carry);
}
