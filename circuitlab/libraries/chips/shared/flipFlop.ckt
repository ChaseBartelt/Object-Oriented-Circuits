# Sampling switches use separated thresholds so both stages cannot track at once.
# Ideal buffers isolate the hold capacitors from the following stage and load.
circuit oocDFlipFlop(vcc, gnd, d, clk, preset_n, clear_n, q, q_n) {  # Each invocation receives private internal nets while its declared ports bind to the caller.
    switchSample(gnd, clk, d, master, -1.5, 100, 1e12);  # The first two nodes control the contact between the third and fourth nodes.
    switchTransfer(clk, gnd, master_buffer, slave, 3.5, 100, 1e12);  # The first two nodes control the contact between the third and fourth nodes.
    switchPreset(vcc, preset_n, vcc, slave, 2.5, 1, 1e12);  # The first two nodes control the contact between the third and fourth nodes.
    switchClear(vcc, clear_n, gnd, slave, 2.5, 1, 1e12);  # The first two nodes control the contact between the third and fourth nodes.
    CMaster(10p) between(master, gnd);
    CSlave(10p) between(slave, gnd);
    op1(master, master_buffer, master_buffer);  # Ideal amplifier: the feedback connections determine this channel's behavior.
    op2(slave, q, q);  # Ideal amplifier: the feedback connections determine this channel's behavior.
    not(vcc, gnd, q, inverted);
    switchInversePreset(vcc, clear_n, vcc, q_n, 2.5, 1, 1e12);  # The first two nodes control the contact between the third and fourth nodes.
    RInverse(100) between(inverted, q_n);
}
