
# LT1677 - Low Noise, Rail-to-Rail Precision Op Amp
# Physical pin order matches the LT1677 datasheet.

chip LT1677(trim1, minus, plus, vminus, nc, out, vplus, trim2) {

    # Standard op-amp symbol and connections
    op1(plus, minus, out, vplus, vminus);

    # Behavioral model for op1
    analog op1 {
        gain = 19e6;
        bandwidth = 7.2MHz;
        slew = 2.5V/us;
        offset = 20uV;
        supply.current = 2.75mA;
    }
}
