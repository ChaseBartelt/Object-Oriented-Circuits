
# LM386 - Low Voltage Audio Power Amplifier
# 8-pin package, datasheet pin order

chip LM386(gain1, minus, plus, gnd,
           out, vcc, bypass, gain8) {

    # Eight-terminal amplifier
    op1(plus, minus, out, vcc, gnd,
        gain1, gain8, bypass);

    analog op1 {
        gain.default = 20;
        gain.max = 200;
        gain.resistor = 1.35k;

        output.bias = 0.5;
        output.type = power_amplifier;

        supply.current = 4mA;
    }
}
