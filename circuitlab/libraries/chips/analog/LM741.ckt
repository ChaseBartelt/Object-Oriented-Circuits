
# LM741 - General-Purpose Operational Amplifier
# 8-pin package, datasheet pin order

chip LM741(offset1, minus, plus, vminus,
           offset2, out, vplus, nc) {

    # Supply-aware amplifier
    op1(plus, minus, out, vplus, vminus);

    analog op1 {
        gain = 200000;
        gbw = 1MHz;
        slew = 0.5V/us;
        offset = 1mV;

        common.min = vminus + 2V;
        common.max = vplus - 2V;

        output.min = vminus + 1V;
        output.max = vplus - 1V;
    }

    # Shared chip power consumption
    analog {
        supply.current.total = 1.7mA;
    }
}

# Generic 741-family compatibility alias
chip uA741(offset1, minus, plus, vminus,
           offset2, out, vplus, nc) {

    LM741(offset1, minus, plus, vminus,
          offset2, out, vplus, nc);
}
