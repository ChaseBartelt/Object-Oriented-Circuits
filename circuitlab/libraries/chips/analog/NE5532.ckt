
# NE5532 - Dual Low-Noise Audio Op Amp
# 8-pin package, pin 1 first

chip NE5532(out1, minus1, plus1, vminus,
            plus2, minus2, out2, vplus) {

    # Two independent amplifier channels
    op1(plus1, minus1, out1, vplus, vminus);
    op2(plus2, minus2, out2, vplus, vminus);

    # Shared amplifier characteristics
    analog (op1, op2) {
        gain = 100000;
        gbw = 12MHz;
        slew = 5V/us;
        offset = 0.5mV;

        common.min = vminus + 2V;
        common.max = vplus - 2V;
    }

    # Total supply current for both channels
    analog {
        supply.current.total = 6mA;
    }
}
