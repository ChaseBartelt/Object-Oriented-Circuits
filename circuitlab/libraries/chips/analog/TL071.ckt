
# TL071 - Low-Noise JFET-Input Op Amp
# Standard 8-pin PDIP / SOIC

chip TL071(nc1, minus, plus, vminus,
           nc5, out, vplus, nc8) {

    op1(plus, minus, out, vplus, vminus);

    analog op1 {
        gain = 200000;
        gbw = 5.25MHz;
        slew = 20V/us;
        offset = 3mV;

        common.min = vminus + 3V;
        common.max = vplus;

        output.min = vminus + 1.5V;
        output.max = vplus - 1.5V;
    }

    analog {
        supply.current.total = 1.4mA;
    }
}
