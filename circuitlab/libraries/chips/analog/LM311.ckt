
# LM311 - Open-Collector Comparator
# 8-pin package, pin 1 first

include("../shared/collectorComparator.ckt");

chip LM311(emitter, plus, minus, vminus,
           balance, strobe, collector, vplus) {

    oocCollectorComparator(
        vplus, vminus,
        plus, minus,
        collector, emitter
    );

    analog oocCollectorComparator {
        offset = 2mV;

        delay.rise = 115ns;
        delay.fall = 165ns;

        output.type = open_collector;
    }
}
