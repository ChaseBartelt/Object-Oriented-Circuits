
# AD633 - Four-Quadrant Analog Multiplier
# 8-pin PDIP package, datasheet pin order

chip AD633(x1, x2, y1, y2,
           vminus, z, w, vplus) {

    analog {
        # Custom scaling property
        properties {
            scale = 10V;
        }

        # Multiplier transfer equation
        V(w) = ((V(x1) - V(x2)) *
                (V(y1) - V(y2))) / scale + V(z);

        # Device characteristics
        bandwidth = 1MHz;
        slew = 20V/us;
        supply.current.total = 4mA;
    }
}
