# SN74HC02 | 14-pin package | pin 1 first.
# 5 V logic-family approximation using OOC transistor gates.
# Datasheet: https://www.ti.com/lit/ds/symlink/sn74hc02.pdf

chip SN74HC02(y1, a1, b1, y2, a2, b2, gnd, a3, b3, y3, a4, b4, y4, vcc) {
    nor(vcc, gnd, a1, b1, y1);
    nor(vcc, gnd, a2, b2, y2);
    nor(vcc, gnd, a3, b3, y3);
    nor(vcc, gnd, a4, b4, y4);
}
