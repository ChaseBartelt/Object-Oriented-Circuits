# SN74HC86 | 14-pin package | pin 1 first.
# 5 V logic-family approximation using OOC transistor gates.
# Datasheet: https://www.ti.com/lit/ds/symlink/sn74hc86.pdf

chip SN74HC86(a1, b1, y1, a2, b2, y2, gnd, y3, a3, b3, y4, a4, b4, vcc) {
    xor(vcc, gnd, a1, b1, y1);
    xor(vcc, gnd, a2, b2, y2);
    xor(vcc, gnd, a3, b3, y3);
    xor(vcc, gnd, a4, b4, y4);
}
